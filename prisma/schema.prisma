// The centralized, source-agnostic business ledger the Procurement spec
// assumes already exists (it didn't). Deliberately a NEW model, not an
// extension of the existing Transaction model -- that model is tightly
// coupled to Wallet (a required FK) and Wallet is itself one-per-User;
// a vendor payment has no User/Wallet involved at all, and forcing one
// in would mean either a fake system wallet or a breaking change to an
// already-live, heavily-used customer financial model. Named
// FinancialTransaction to stay clearly distinct from Transaction.
enum FinancialTransactionDirection {
  INFLOW
  OUTFLOW
}

// Combines the spec's "source module" and "transaction type" into one
// enum -- in every example the spec gives (§24), they're the same thing
// ("Procurement creates: Outflow -> Vendor Payment").
enum FinancialTransactionCategory {
  // Inflows
  SALON_BOOKING_REVENUE
  PRODUCT_SALE
  ACADEMY_PAYMENT
  MEMBERSHIP_PAYMENT
  WALLET_FUNDING
  OTHER_INCOME
  // Outflows
  VENDOR_PAYMENT
  SALARY
  REFUND
  OPERATIONAL_EXPENSE
  LOGISTICS
  OTHER_EXPENSE
}

/**
 * One row per actual money movement, regardless of which module caused
 * it. sourceType/sourceId are a deliberately free-text polymorphic
 * reference (not a typed relation) -- same "Source Transaction" pattern
 * StockMovement already uses, since the set of possible source modules
 * will keep growing as later phases land (Purchase, Payroll, etc.) and
 * a typed FK to each one individually isn't practical. paymentMethod is
 * free text, not an enum -- the two existing PaymentMethod-style enums
 * in this schema are customer-gateway-specific (Paystack/Monnify/
 * Wallet), not business payment methods like bank transfer or cheque.
 */
model FinancialTransaction {
  id             String                        @id @default(uuid())
  // Postgres's own autoincrement is atomic/collision-free under
  // concurrency, unlike a "count existing rows + 1" approach -- exactly
  // the same reasoning and pattern as SalonBooking.bookingNumber. The
  // human-readable reference (FIN-2026-00125) is formatted from this at
  // the application layer, never generated by counting rows.
  sequenceNumber Int                           @default(autoincrement()) @map("sequence_number")
  reference      String                        @unique // e.g. "FIN-2026-00125"
  direction      FinancialTransactionDirection
  category      FinancialTransactionCategory
  amount        Decimal                       @db.Decimal(12, 2)
  branchId      String?                       @map("branch_id")
  description   String?
  paymentMethod String?                       @map("payment_method")
  recordedById  String?                       @map("recorded_by_id") // null = system-generated, no human actor
  sourceType    String?                       @map("source_type") // e.g. "ProductSale", "SalonBooking"
  sourceId      String?                       @map("source_id")
  createdAt     DateTime                      @default(now()) @map("created_at")

  branch     StaffLocation? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  recordedBy User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  purchasePayment PurchasePayment?

  @@index([direction, createdAt])
  @@index([category])
  @@index([branchId])
  @@index([sourceType, sourceId])
  @@map("financial_transactions")
}

