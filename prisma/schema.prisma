// One row per (staff, day-of-week) — an employee's own weekly work
// pattern, replacing reliance on the single global BusinessHours for
// attendance decisions (HCS v1.0 Part B, Section 1). A day not present in
// this table for a given staff member is treated as WORKING using the
// company's own BusinessHours for that day, so a brand-new staff member
// with nothing configured yet still behaves sensibly by default.
model StaffWorkCalendar {
  id          String           @id @default(uuid())
  staffId     String           @map("staff_id")
  dayOfWeek   Int              @map("day_of_week") // 0=Sunday ... 6=Saturday
  dayType     StaffWorkDayType @default(WORKING) @map("day_type")
  resumeTime  String?          @map("resume_time") // "HH:mm" — null when dayType is OFF
  closingTime String?          @map("closing_time") // "HH:mm" — null when dayType is OFF

  // "Alternate Saturdays" and similar biweekly patterns: when set, dayType
  // above only applies on weeks matching activeWeekParity (ISO week number
  // parity — 0 or 1); the opposite weeks use alternateDayType instead
  // (typically OFF), so "working every other Saturday" is expressed
  // without needing a second row or a separate table.
  alternatesBiweekly Boolean           @default(false) @map("alternates_biweekly")
  activeWeekParity   Int?              @map("active_week_parity")
  alternateDayType   StaffWorkDayType? @map("alternate_day_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
  @@map("staff_work_calendars")
}

enum ExtraWorkDayApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRecord {
  id         String    @id @default(uuid())
  staffId    String    @map("staff_id")
  locationId String    @map("location_id")
  date       DateTime  @db.Date
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  checkInLat  Decimal? @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng  Decimal? @map("check_in_lng") @db.Decimal(10, 7)
  checkOutLat Decimal? @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng Decimal? @map("check_out_lng") @db.Decimal(10, 7)

  status                AttendanceStatus @default(PRESENT)
  lateMinutes           Int?             @map("late_minutes")
  latePenaltyAmount     Decimal?         @map("late_penalty_amount") @db.Decimal(10, 2) // minutes late beyond grace period × LatePenaltySettings.amountPerMinute, captured at check-in time
  absentFeeAmount       Decimal?         @map("absent_fee_amount") @db.Decimal(10, 2) // that day's expected working minutes × LatePenaltySettings.amountPerMinute, captured the moment ABSENT is recorded — never recomputed later, same freeze-at-the-moment convention as latePenaltyAmount
  overtimeMinutes       Int?             @map("overtime_minutes")
  earlyDepartureMinutes Int?             @map("early_departure_minutes")

  isManuallyAdjusted       Boolean                   @default(false) @map("is_manually_adjusted")
  adjustmentReasonCategory AttendanceOverrideReason? @map("adjustment_reason_category")
  adjustmentReason         String?                   @map("adjustment_reason") // free-text detail — required when adjustmentReasonCategory is OTHER, optional otherwise
  adjustedById             String?                   @map("adjusted_by_id")

  // HCS v1.0 Part B, Phase 3 — set only when status is EXTRA_WORK_DAY_PENDING
  // (a clock-in on a day the staff member's own calendar marks OFF). status
  // itself stays EXTRA_WORK_DAY_PENDING permanently as the record-type
  // marker; the approval decision lives here instead, separately, so
  // approving/rejecting doesn't require inventing more AttendanceStatus
  // values or reinterpreting what "pending" means once decided.
  extraWorkDayApproval    ExtraWorkDayApprovalStatus? @map("extra_work_day_approval")
  extraWorkDayDecidedById String?                     @map("extra_work_day_decided_by_id")
  extraWorkDayDecidedAt   DateTime?                   @map("extra_work_day_decided_at")
  extraWorkDayNote        String?                     @map("extra_work_day_note") // admin's reason, especially for a rejection

  createdAt DateTime @default(now()) @map("created_at")

  staff                 Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location              StaffLocation @relation(fields: [locationId], references: [id])
  adjustedBy            User?         @relation("AttendanceAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
  extraWorkDayDecidedBy User?         @relation("AttendanceExtraWorkDayDecidedBy", fields: [extraWorkDayDecidedById], references: [id], onDelete: SetNull)

  @@unique([staffId, date])
  @@index([locationId, date])
  @@index([status, extraWorkDayApproval])
  @@map("attendance_records")
}

