/**
 * Procurement/Inventory/Finance Integration, Phase 6. A service's
 * "recipe" -- e.g. Hair Treatment = 1 Shampoo + 1 Conditioner + 1
 * Treatment Cream. Deliberately keyed to InventoryProduct (the global,
 * branch-independent master record) rather than InventoryItem (the
 * per-branch stock row) -- the recipe itself is the same everywhere a
 * service is performed; only the actual deduction at completion time
 * needs to resolve down to a specific branch's InventoryItem for that
 * product. Spec: "marking a service Completed automatically deducts
 * from Usage Stock and records Product Usage -- staff never manually
 * deduct."
 */
model ServiceProductConsumption {
  id        String @id @default(uuid())
  serviceId String @map("service_id")
  productId String @map("product_id")
  quantity  Int    @default(1)

  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
  @@index([productId])
  @@map("service_product_consumption")
}

