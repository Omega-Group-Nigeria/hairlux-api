// Mirrors the meaningful states of this feature's actual lifecycle --
// NOT QoreID's own status.state values directly, since those only exist
// once QoreID has been called at all. REQUESTED/SUBMITTED are ours,
// covering the two stages before that ever happens.
enum AddressVerificationStatus {
  REQUESTED    // admin asked; staff hasn't filled the form yet
  SUBMITTED    // staff submitted; QoreID has it, physical visit in progress (24-48h)
  VERIFIED
  REJECTED
  FAILED       // e.g. QoreID couldn't complete the visit at all
  // Dev Feedback Round 4, item #12: admin stopped tracking this request
  // before it reached a real outcome. Purely internal bookkeeping -- does
  // NOT actually stop QoreID's physical field visit if one was already
  // in progress at the moment of cancellation.
  CANCELLED
}

model StaffAddressVerification {
  id            String                     @id @default(uuid())
  staffId       String                     @unique @map("staff_id")
  status        AddressVerificationStatus  @default(REQUESTED)
  requestedById String?                    @map("requested_by_id") // Staff.id of the admin who requested it -- nullable, admin-elevated action with no linked staff record
  requestedAt   DateTime                   @default(now()) @map("requested_at")

  // Submitted by the staff member on the Staff Portal form
  street              String?
  city                String?
  lgaName             String?              @map("lga_name")
  stateName           String?              @map("state_name")
  landmark            String?
  houseNumber         String?              @map("house_number")
  generalDescription  String?              @map("general_description")
  latitude            Decimal?             @db.Decimal(10, 7)
  longitude           Decimal?             @db.Decimal(10, 7)
  buildingDescription String?              @map("building_description") // Residential | Commercial
  hasGateAndFence     Boolean?             @map("has_gate_and_fence")
  buildingStatus      String?              @map("building_status") // Completed | Painted | Completed and Painted
  buildingType        String?              @map("building_type") // Multi-story | Flats & Apartment | Bungalow | Office Complex
  buildingColour      String?              @map("building_colour")
  // S3 object keys, same private-bucket + fresh-presigned-URL-on-view
  // convention as Staff.passportPhotoUrl -- never a permanent public link.
  photo1Key           String?              @map("photo1_key")
  photo2Key           String?              @map("photo2_key")
  photo3Key           String?              @map("photo3_key")
  submittedAt         DateTime?            @map("submitted_at")

  // From QoreID
  qoreidVerificationId String?             @unique @map("qoreid_verification_id")
  qoreidStatus         String?             @map("qoreid_status")
  qoreidSubStatus      String?             @map("qoreid_sub_status")
  qoreidState          String?             @map("qoreid_state")
  reportUrl            String?             @map("report_url")
  resultReceivedAt     DateTime?           @map("result_received_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff       Staff  @relation("StaffAddressVerification", fields: [staffId], references: [id], onDelete: Cascade)
  requestedBy Staff? @relation("AddressVerificationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([status])
  @@map("staff_address_verifications")
}

