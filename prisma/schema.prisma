  application Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  jobPosting  JobPosting?    @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  branch      StaffLocation? @relation("OfferLetterBranch", fields: [branchId], references: [id], onDelete: SetNull)
  generatedBy User           @relation("OfferLetterGeneratedBy", fields: [generatedById], references: [id])

  @@index([status])
  @@map("offer_letters")
}

model EmploymentApproval {
  id            String   @id @default(uuid())
  applicationId String   @unique @map("application_id")
  approvedById  String   @map("approved_by_id")
  approvedAt    DateTime @default(now()) @map("approved_at")
  notes         String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvedBy  User        @relation("EmploymentApprovalApprovedBy", fields: [approvedById], references: [id])

  @@map("employment_approvals")
}

// One model covers both Suppliers and Vendors (distinguished by `type`) —
// they share identical shape and both link to InventoryItem the same way;
// the UI presents them as two separate lists under Contacts.
model Supplier {
  id            String       @id @default(uuid())
  type          SupplierType
  name          String
  contactPerson String?      @map("contact_person")
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // ── Procurement/Inventory/Finance Integration, Phase 1 additions ──
  // Deliberately extending the existing Supplier model rather than
  // introducing a separate "Vendor" model -- the spec's "Vendor" is the
  // same real-world concept this model already represents (distinguished
  // by `type`), and a rename/split would be a large, risky, cascading
  // change touching every existing reference. Banking fields must stay
  // access-restricted to authorized users at the service/serializer layer
  // -- schema alone doesn't enforce that.
  whatsapp            String?  @map("whatsapp")
  vendorCategory      String?  @map("vendor_category")
  city                String?
  state               String?
  bankName            String?  @map("bank_name")
  accountNumber       String?  @map("account_number")
  verifiedAccountName String?  @map("verified_account_name")
  paymentTerms        String?  @map("payment_terms")
  averageDeliveryDays Int?     @map("average_delivery_days")
  performanceRating   Decimal? @map("performance_rating") @db.Decimal(3, 2)
  isPreferred         Boolean  @default(false) @map("is_preferred")
  remarks             String?

  inventoryItems      InventoryItem[]
  suppliedProducts    VendorProduct[]
  purchaseRequests    PurchaseRequest[]
  purchases           Purchase[]
  ledgerAdjustments   VendorLedgerAdjustment[]

  @@index([type])
  @@map("suppliers")
}

/**
 * The global, branch-independent product master record the whole
 * Procurement/Inventory/Finance rebuild is anchored on. Deliberately
 * NOT named "Product" -- that name is already taken by the unrelated
 * customer-facing e-commerce Shop model (Product/ProductCategory/
 * ProductImage). This is Phase 1 only: InventoryItem keeps its existing
 * per-branch currentQuantity behavior unchanged for now via an optional
 * link -- Phase 2 does the actual Store/Sales/Usage split and migration.
 */
model InventoryProduct {
  id                    String            @id @default(uuid())
  name                  String
  sku                   String?           @unique
  brand                 String?
  // Dev Feedback Round 8: changed from a single InventoryCategory to an
  // array -- a product (e.g. a shampoo) can genuinely belong to more
  // than one category (FOR_SALE and INTERNAL_USE at once) rather than
  // being forced into exactly one. Field name kept singular despite the
  // type change, to minimize churn across the DTO/service/frontend that
  // already reference `category`.
  category              InventoryCategory[]
  productType           String?           @map("product_type") // free text -- spec doesn't define a fixed list
  unit                  String?
  costPrice             Decimal?          @map("cost_price") @db.Decimal(10, 2)
  sellingPrice          Decimal?          @map("selling_price") @db.Decimal(10, 2)
  bulkSellingPrice      Decimal?          @map("bulk_selling_price") @db.Decimal(10, 2)
  minBulkQuantity       Int?              @map("min_bulk_quantity")
  lowStockThreshold     Int               @default(5) @map("low_stock_threshold")
  expiryTrackingEnabled Boolean           @default(false) @map("expiry_tracking_enabled")
  description           String?
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  suppliers      VendorProduct[]
  inventoryItems InventoryItem[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseLines        PurchaseLine[]
  serviceConsumption   ServiceProductConsumption[]

  @@index([isActive])
  @@index([category])
  @@map("inventory_products")
}

/**
 * Many-to-many: one vendor can supply many products, one product can be
 * sourced from multiple vendors (common in real procurement -- price-
 * comparing the same item across suppliers).
 */
model VendorProduct {
  id        String @id @default(uuid())
  vendorId  String @map("vendor_id")
  productId String @map("product_id")

  vendor  Supplier         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vendorId, productId])
  @@index([productId])
  @@map("vendor_products")
}

model InventoryItem {
  id                String            @id @default(uuid())
  name              String
  category          InventoryCategory
  branchId          String            @map("branch_id")
  supplierId        String?           @map("supplier_id")
  productId         String?           @map("product_id")
  unit              String? // e.g. "pcs", "bottle", "ml"
  // Phase 2: currentQuantity is GONE, not deprecated-in-place. Keeping it
  // alongside the three new columns risked exactly the kind of silent
  // data drift this rebuild exists to eliminate -- any write path that
  // updated the new columns without also updating this one would leave
  // it stale and wrong. Removing it outright means TypeScript compilation
  // itself catches every remaining reference; a currentQuantity read/write
  // site that isn't updated in this same phase simply fails to compile,
  // rather than silently drifting in production later.
  storeStock        Int               @default(0) @map("store_stock") // unallocated, freshly received
  salesStock        Int               @default(0) @map("sales_stock") // for sale to customers
  usageStock        Int               @default(0) @map("usage_stock") // for consumption during services
  lowStockThreshold Int               @default(5) @map("low_stock_threshold")
  expiryDate        DateTime?         @map("expiry_date") @db.Date
  isActive          Boolean           @default(true) @map("is_active")
  price             Decimal?          @map("price") @db.Decimal(10, 2) // required (enforced in service layer) when category = FOR_SALE
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  branch             StaffLocation               @relation(fields: [branchId], references: [id])
  supplier           Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product            InventoryProduct?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  movements          StockMovement[]
  lowStockAlerts     LowStockAlert[]
  expiryAlerts       ExpiryAlert[]
  saleItems          ProductSaleItem[]
  transfersOut       StockTransfer[]             @relation("TransferFromItem")
  adjustmentRequests StockAdjustmentRequest[]
  salonBookingLines  SalonBookingInventoryItem[]

  @@unique([branchId, name, category])
  @@index([branchId, category])
  @@index([supplierId])
  @@index([productId])
  @@map("inventory_items")
}

// A stock adjustment awaiting approval — the actual InventoryItem.currentQuantity
// mutation only happens once the linked ApprovalRequest reaches APPROVED (see
// InventoryService.approveStockAdjustment), not at request time. `status`
// mirrors the ApprovalRequest's status for fast filtering without a join.
model StockAdjustmentRequest {
  id                String         @id @default(uuid())
  itemId            String         @map("item_id")
  // Phase 2: which of the three buckets this adjustment corrects. Required,
  // no default -- every new adjustment must explicitly state this rather
  // than silently assume one, matching the spec's Stock Type field on the
  // adjustment record.
  stockType         StockType      @map("stock_type")
  quantityDelta     Int            @map("quantity_delta")
  // Phase 7: constrained category (spec's fixed list), required -- same
  // "required, no default" convention as stockType above. reason itself
  // relaxed to optional alongside it: still required in practice when
  // reasonCategory is OTHER (enforced by AdjustStockDto), but a category
  // like DAMAGED or FOUND is often self-explanatory without a note.
  reasonCategory    StockAdjustmentReason @map("reason_category")
  reason            String?
  requestedById     String?        @map("requested_by_id") // null = admin-initiated with no linked staff record
  approvalRequestId String         @unique @map("approval_request_id")
  status            ApprovalStatus @default(PENDING)
  appliedAt         DateTime?      @map("applied_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  item            InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requestedBy     Staff?          @relation(fields: [requestedById], references: [id])
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([itemId, status])
  @@map("stock_adjustment_requests")
}

// A standalone product sale — walk-in customer buying a FOR_SALE item with
// no service attached. Distinct from SalonBooking's "products used/sold"
// lines, which are always tied to a service appointment; this is for a pure
// retail transaction (e.g. someone just wants a bottle of shampoo).
model ProductSale {
  id            String   @id @default(uuid())
  branchId      String   @map("branch_id")
  soldById      String?  @map("sold_by_id") // null = admin-initiated with no linked staff record
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  branch StaffLocation     @relation(fields: [branchId], references: [id])
  soldBy Staff?            @relation(fields: [soldById], references: [id], onDelete: SetNull)
  items  ProductSaleItem[]

  @@index([branchId, createdAt])
  @@map("product_sales")
}

model ProductSaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  itemId    String  @map("item_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  // Phase 8: the spec's own, previously-unfulfilled promise -- "Product
  // Sale automatically records revenue, identifies cost, records COGS,
  // calculates Gross Profit." Snapshotted from InventoryProduct.costPrice
  // at the moment of sale, same "never recomputed later" principle used
  // everywhere else in this project (Payslip's rate snapshots, Purchase's
  // price snapshots) -- a cost change afterward must never silently
  // rewrite a past sale's recorded margin. Nullable: InventoryItem.productId
  // is itself optional, so cost is genuinely unknown for an item with no
  // linked master record.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(10, 2)

  sale ProductSale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@map("product_sale_items")
}

// One end-of-day cash count per branch per date. Both revenue figures are
// snapshotted at submission time rather than recalculated live later, so a
// past reconciliation stays meaningful even if underlying records are
// edited afterward.
//
// expectedCash excludes wallet-paid customer self-service bookings (money
// already collected digitally, not physically) — everything else (walk-in
// SalonBooking, ProductSale, and non-wallet self-service Booking) is
// treated as cash for now, since neither SalonBooking nor ProductSale
// record a payment method yet, and MONNIFY/PAYSTACK on Booking aren't a
// live gateway in this flow yet either. Revisit this once real payment
// tracking exists across all three.
model DailyCashReconciliation {
  id            String   @id @default(uuid())
  branchId      String   @map("branch_id")
  date          DateTime @db.Date
  totalRevenue  Decimal  @map("total_revenue") @db.Decimal(10, 2) // every revenue source, wallet included
  expectedCash  Decimal  @map("expected_cash") @db.Decimal(10, 2) // totalRevenue minus wallet-paid bookings
  cashCounted   Decimal  @map("cash_counted") @db.Decimal(10, 2)
  variance      Decimal  @db.Decimal(10, 2) // cashCounted - expectedCash
  notes         String?
  submittedById String?  @map("submitted_by_id")
  submittedAt   DateTime @default(now()) @map("submitted_at")

  branch      StaffLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)
  submittedBy Staff?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@unique([branchId, date])
  @@index([branchId, date])
  @@map("daily_cash_reconciliations")
}

model StockMovement {
  id            String            @id @default(uuid())
  itemId        String            @map("item_id")
  type          StockMovementType
  // Phase 2: nullable, unlike the other two models above -- historical
  // movements that predate this phase genuinely have no stock type to
  // backfill accurately, and forcing one would be a guess presented as
  // fact. Every new movement going forward should always set it.
  stockType     StockType?        @map("stock_type")
  quantityDelta Int               @map("quantity_delta") // positive or negative
  referenceId   String?           @map("reference_id") // links to a Sale, Transfer, or AdjustmentRequest
  performedById String?           @map("performed_by_id") // null = admin-initiated with no linked staff record
  reason        String? // required for ADJUSTMENT
  // Phase 7: constrained category, required specifically for ADJUSTMENT
  // movements -- nullable here too since every other movement type, and
  // historical adjustments that predate this field, have none.
  reasonCategory StockAdjustmentReason? @map("reason_category")
  createdAt     DateTime          @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy Staff?        @relation(fields: [performedById], references: [id])

  @@index([itemId, createdAt])
  @@map("stock_movements")
}

model LowStockAlert {
  id           String             @id @default(uuid())
  itemId       String             @map("item_id")
  triggeredAt  DateTime           @default(now()) @map("triggered_at")
  currentStage LowStockAlertStage @default(SUPERVISOR) @map("current_stage")
  escalatedAt  DateTime?          @map("escalated_at")
  resolvedAt   DateTime?          @map("resolved_at")
  resolvedById String?            @map("resolved_by_id")

  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resolvedBy Staff?        @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([itemId, resolvedAt])
  @@map("low_stock_alerts")
}

model ExpiryAlert {
  id           String              @id @default(uuid())
  itemId       String              @map("item_id")
  severity     ExpiryAlertSeverity
  triggeredAt  DateTime            @default(now()) @map("triggered_at")
  resolvedAt   DateTime?           @map("resolved_at")
  resolvedById String?             @map("resolved_by_id")

  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  resolvedBy Staff?        @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([itemId, resolvedAt])
  @@map("expiry_alerts")
}

model StockTransfer {
  id                String              @id @default(uuid())
  fromItemId        String              @map("from_item_id")
  toBranchId        String              @map("to_branch_id")
  // Phase 2: which bucket this transfer moves FROM at the source branch --
  // per the spec's Stock Purpose field. The destination item receives the
  // same stock type on the TO side; a transfer never changes bucket, only
  // branch (re-bucketing is a separate, internal ALLOCATED movement).
  stockType         StockType           @map("stock_type")
  quantity          Int
  status            StockTransferStatus @default(PENDING)
  requestedById     String              @map("requested_by_id")
  approvedById      String?             @map("approved_by_id")
  approvedAt        DateTime?           @map("approved_at")
  completedAt       DateTime?           @map("completed_at")
  rejectionReason   String?             @map("rejection_reason")
  approvalRequestId String?             @unique @map("approval_request_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  fromItem        InventoryItem    @relation("TransferFromItem", fields: [fromItemId], references: [id])
  toBranch        StaffLocation    @relation(fields: [toBranchId], references: [id])
  requestedBy     Staff            @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy      Staff?           @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  @@map("stock_transfers")
}
 