  previousEmployerPhone     String?
  coverNote                 String?
  preferredLocationId       String?
  preferredBranchText       String?
  cvUrl                     String?
  portfolioUrl              String?
  status                    ApplicationStatus   @default(SUBMITTED)
  interviewScheduledAt      DateTime?
  interviewMode             InterviewMode?
  interviewLocationId       String?
  interviewLocation         StaffLocation?      @relation("ApplicationInterviewLocation", fields: [interviewLocationId], references: [id], onDelete: SetNull)
  interviewMeetingUrl       String?
  interviewerName           String?
  interviewNote             String?
  interviewOutcome          InterviewOutcome?
  interviewerId             String?
  interviewer               Staff?              @relation("ApplicationInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
