// Backs the per-NIN verification cooldown — one row per NIN, updated every
// time an attempt actually reaches QoreID (a cache-hit answered from an
// existing Application record does NOT touch this, since it never calls
// QoreID at all). NIN_VERIFY_COOLDOWN_MINUTES (.env, default 5) controls
// how long a NIN is locked out after a real attempt.
model NinVerificationAttempt {
  id            String   @id @default(uuid())
  nin           String   @unique
  lastAttemptAt DateTime @map("last_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("nin_verification_attempts")
}

model Application {
