// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  BEAUTICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MatchingExhaustedReason {
  NO_BEAUTICIANS_ONLINE
  NO_CANDIDATES_IN_AREA
  OFFERS_NOT_ACCEPTED
  COVERAGE_GAP
}

enum DispatchStatus {
  PENDING_MATCH
  OFFERING
  MATCH_EXHAUSTED
  ASSIGNED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PENDING_ASSIGNMENT
  CONFIRMED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  ARRIVED_VERIFIED
  IN_PROGRESS
  COMPLETED
  AWAITING_CUSTOMER_CONFIRM
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CASH
  MONNIFY
  PAYSTACK
}

enum TransactionType {
  DEPOSIT
  BOOKING_PAYMENT
  DEBIT
  CREDIT
  REFUND
  INFLUENCER_REWARD
  SHOP_PURCHASE
  SERVICE_EARNINGS
  PAYOUT_REQUEST
  PAYOUT_COMPLETED
}

enum KycStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
  SUSPENDED
  NEEDS_REVIEW
}

enum ProfileReviewStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  OFFLINE
  ONLINE
  OFFERED
  ON_JOB
}

enum JobOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  TIMED_OUT
  CANCELLED
}

enum PayoutMode {
  MANUAL
  AUTO
}

enum PayoutRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum BookingCommsSessionStatus {
  ACTIVE
  CLOSED
}

enum BookingCommsCloseReason {
  CUSTOMER_CONFIRMED
  AUTO_FINALIZED
  CANCELLED
  REASSIGNED
}

enum BookingCommsEventType {
  CHAT_MESSAGE
  CALL_STARTED
  CALL_ENDED
}

enum FcmPlatform {
  IOS
  ANDROID
  WEB
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ShopOrderStatus {
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionPaymentMethod {
  WALLET
  REFERRAL
  PAYSTACK
  MONNIFY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ReferralRewardType {
  FIXED
  PERCENTAGE
}

enum ReferralStatus {
  PENDING
  REWARDED
  FAILED
}

enum DiscountType {
  GENERAL
  INFLUENCER
}

enum BookingType {
  HOME_SERVICE
  WALK_IN
  MIXED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum StaffEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
  ARCHIVED
}

enum StaffEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  role             UserRole  @default(USER)
  status           UserStatus @default(ACTIVE)
  emailVerified    Boolean   @default(false) @map("email_verified")
  otpCode          String?   @map("otp_code")
  otpExpiry        DateTime? @map("otp_expiry")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  currentSessionId String?   @map("current_session_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // PIN (transaction / security PIN) - stored hashed
  pin                String?   @map("pin")
  pinSetAt           DateTime? @map("pin_set_at")
  pinFailedAttempts  Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil     DateTime? @map("pin_locked_until")

  adminRoleId      String?    @map("admin_role_id")

  // Relations
  addresses       Address[]
  bookings        Booking[]
  wallet          Wallet?
  reviews         Review[]
  refreshTokens   RefreshToken[]
  referralCode    ReferralCode?
  referrals       Referral[]     @relation("ReferrerUser")
  referredBy      Referral?      @relation("ReferredUser")
  referralCampaignUsages ReferralCampaignCodeUsage[]
  discountUsages  DiscountUsage[] @relation("UserDiscountUsages")
  adminRole       AdminRole?     @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  influencer      Influencer?
  shopOrders      ShopOrder[]
  beauticianProfile        BeauticianProfile?
  assignedBookings         Booking[] @relation("AssignedBeautician")
  jobOffers                JobOffer[]
  beauticianServicesAssigned BeauticianService[] @relation("BeauticianServiceAssignedBy")
  profileReviewsPerformed  BeauticianProfile[] @relation("ProfileReviewedBy")
  payoutRequests           PayoutRequest[] @relation("UserPayoutRequests")
  payoutsProcessed         PayoutRequest[] @relation("PayoutProcessedBy")
  fcmTokens                FcmToken[]
  beauticianLocationHistory BeauticianLocationHistory[] @relation("BeauticianLocationHistory")

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  label        String?  // e.g., "Home", "Office"
  fullAddress  String   @map("full_address")
  streetAddress String? @map("street_address")
  city         String?
  state        String?
  country      String   @default("Nigeria")
  placeId      String?  @map("place_id")
  addressComponents Json? @map("address_components")
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  shopOrders ShopOrder[]

  @@index([userId])
  @@map("addresses")
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String        @id @default(uuid())
  categoryId  String        @map("category_id")
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category ProductCategory @relation(fields: [categoryId], references: [id])
  images   ProductImage[]

  @@index([status])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  publicId  String   @map("public_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model DeliveryRegion {
  id          String   @id @default(uuid())
  name        String
  state       String   @unique
  deliveryFee Decimal  @db.Decimal(10, 2) @map("delivery_fee")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("delivery_regions")
}

model ShopOrder {
  id                      String          @id @default(uuid())
  orderCode               String          @unique @map("order_code")
  userId                  String          @map("user_id")
  addressId               String          @map("address_id")
  items                   Json
  deliveryAddressSnapshot Json            @map("delivery_address_snapshot")
  subtotal                Decimal         @db.Decimal(10, 2)
  deliveryFee             Decimal         @db.Decimal(10, 2) @map("delivery_fee")
  totalAmount             Decimal         @db.Decimal(10, 2) @map("total_amount")
  status                  ShopOrderStatus @default(CONFIRMED)
  idempotencyKey          String?         @map("idempotency_key")
  notes                   String?
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  address Address @relation(fields: [addressId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@map("shop_orders")
}

model ServiceCategory {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  services Service[]

  @@map("service_categories")
}

model Service {
  id          String        @id @default(uuid())
  categoryId  String        @map("category_id")
  name        String
  description String?
  walkInPrice Decimal       @db.Decimal(10, 2) @map("walk_in_price")
  homeServicePrice Decimal  @db.Decimal(10, 2) @map("home_service_price")
  isWalkInAvailable Boolean @default(true) @map("is_walk_in_available")
  isHomeServiceAvailable Boolean @default(true) @map("is_home_service_available")
  duration    Int           // Duration in minutes
  imageUrl    String?       @map("image_url")
  imagePublicId String?     @map("image_public_id")
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  category            ServiceCategory @relation(fields: [categoryId], references: [id])
  reviews             Review[]
  branchServices      BranchService[]
  beauticianServices  BeauticianService[]

  @@map("services")
}

model Booking {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  // services is a JSON array: [{serviceId, name, price, quantity, duration, notes?, serviceMode?}]
  services         Json          @map("services")
  addressId        String?       @map("address_id")  // null for WALK_IN-only bookings
  branchId         String?       @map("branch_id")
  bookingDate      DateTime      @map("booking_date")
  bookingTime      String        @map("booking_time") // Format: "HH:mm"
  bookingType      BookingType   @default(HOME_SERVICE) @map("booking_type")
  reservationCode  String        @unique @map("reservation_code")
  reservationUsed  Boolean       @default(false) @map("reservation_used")
  guestName        String?       @map("guest_name")   // null = booking for self
  guestPhone       String?       @map("guest_phone")  // null = booking for self
  guestEmail       String?       @map("guest_email")  // if set, notification email sent to guest
  idempotencyKey   String?       @map("idempotency_key")
  status           BookingStatus @default(PENDING)
  paymentMethod    PaymentMethod @map("payment_method")
  totalAmount      Decimal       @db.Decimal(10, 2) @map("total_amount")
  notes            String?
  cancelReason     String?       @map("cancel_reason")
  assignedBeauticianUserId String? @map("assigned_beautician_user_id")
  arrivalVerifiedAt        DateTime? @map("arrival_verified_at")
  serviceStartedAt         DateTime? @map("service_started_at")
  serviceCompletedAt       DateTime? @map("service_completed_at")
  beauticianArrivalLat     Decimal?  @db.Decimal(10, 7) @map("beautician_arrival_lat")
  beauticianArrivalLng     Decimal?  @db.Decimal(10, 7) @map("beautician_arrival_lng")
  customerRating           Int?      @map("customer_rating")
  customerReview           String?   @map("customer_review")
  matchingAttempt          Int                     @default(1) @map("matching_attempt")
  matchingStartedAt        DateTime?               @map("matching_started_at")
  matchingExhaustedAt      DateTime?               @map("matching_exhausted_at")
  matchingExhaustedReason  MatchingExhaustedReason? @map("matching_exhausted_reason")
  dispatchStatus           DispatchStatus?         @map("dispatch_status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  address Address? @relation(fields: [addressId], references: [id])
  branch  StaffLocation? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedBeautician User? @relation("AssignedBeautician", fields: [assignedBeauticianUserId], references: [id], onDelete: SetNull)
  review  Review?
  discountUsage DiscountUsage?
  jobOffers JobOffer[]
  dispatchEvents DispatchEvent[]
  locationHistory BeauticianLocationHistory[]
  commsSession BookingCommsSession?

  @@index([reservationCode])
  @@index([userId])
  @@index([status])
  @@index([bookingDate])
  @@index([userId, status])
  @@index([assignedBeauticianUserId])
  @@unique([userId, idempotencyKey])
  @@map("bookings")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id                String            @id @default(uuid())
  walletId          String            @map("wallet_id")
  type              TransactionType
  amount            Decimal           @db.Decimal(10, 2)
  status            TransactionStatus @default(PENDING)
  paymentMethod     TransactionPaymentMethod @default(WALLET) @map("payment_method")
  reference         String            @unique // Payment gateway reference or internal ref
  description       String?
  metadata          Json?             // Store additional payment details
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  wallet           Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  influencerReward InfluencerReward?
  referralCampaignUsage ReferralCampaignCodeUsage?
  payoutRequest    PayoutRequest?

  @@index([walletId])
  @@index([walletId, status])
  @@map("transactions")
}

model Review {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  serviceId String       @map("service_id")
  bookingId String       @unique @map("booking_id")
  rating    Int          // 1-5
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@map("reviews")
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  businessName       String   @map("business_name")
  email              String
  phone              String
  address            String
  slotDuration       Int      @default(30) @map("slot_duration")        // Booking slot length in minutes
  advanceBookingDays Int      @default(30) @map("advance_booking_days") // How many days ahead bookings allowed
  minNoticeHours     Int      @default(2) @map("min_notice_hours")      // Minimum hours before a booking
  maxBookingsPerDay  Int      @default(10) @map("max_bookings_per_day")
  bookingPolicy      String?  @map("booking_policy")
  cancellationPolicy String?  @map("cancellation_policy")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model BusinessHours {
  id        String   @id @default(uuid())
  dayOfWeek Int      @unique @map("day_of_week") // 0=Sunday, 1=Monday ... 6=Saturday
  openTime  String   @map("open_time")            // Format: "HH:mm"
  closeTime String   @map("close_time")           // Format: "HH:mm"
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_hours")
}

model BusinessException {
  id        String   @id @default(uuid())
  date      DateTime @unique                      // Specific calendar date
  isClosed  Boolean  @default(true) @map("is_closed")
  openTime  String?  @map("open_time")            // Override open time (only if not closed)
  closeTime String?  @map("close_time")           // Override close time (only if not closed)
  reason    String?                               // e.g. "Christmas Holiday"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_exceptions")
}

model Influencer {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")  // linked user account
  notes       String?   // internal admin notes
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCodes    DiscountCode[]
  influencerRewards InfluencerReward[]

  @@map("influencers")
}

model DiscountCode {
  id              String       @id @default(uuid())
  code            String       @unique              // e.g. "SUMMER20" — case-insensitive at app level
  name            String                            // e.g. "Summer Sale"
  percentage      Float                             // e.g. 20.0 (represents 20%)
  type            DiscountType @default(GENERAL) @map("type")
  influencerId    String?      @map("influencer_id")   // null for GENERAL codes
  isActive        Boolean      @default(true) @map("is_active")
  startsAt        DateTime?    @map("starts_at")    // null = active immediately
  expiresAt       DateTime?    @map("expires_at")   // null = never expires
  maxUses         Int?         @map("max_uses")     // null = unlimited
  usedCount       Int          @default(0) @map("used_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  influencer Influencer?   @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  usages     DiscountUsage[]

  @@index([influencerId])
  @@map("discount_codes")
}

model DiscountUsage {
  id             String   @id @default(uuid())
  discountCodeId String   @map("discount_code_id")
  userId         String   @map("user_id")
  bookingId      String   @unique @map("booking_id")
  discountAmount Decimal  @db.Decimal(10, 2) @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  discountCode     DiscountCode      @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  user             User              @relation("UserDiscountUsages", fields: [userId], references: [id])
  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  influencerReward InfluencerReward?

  @@index([discountCodeId])
  @@index([userId])
  @@map("discount_usages")
}

model InfluencerRewardSettings {
  id                String             @id @default(uuid())
  isActive          Boolean            @default(false) @map("is_active")
  rewardType        ReferralRewardType @default(FIXED) @map("reward_type")
  rewardValue       Decimal            @default(0) @db.Decimal(10, 2) @map("reward_value")
  minPurchaseAmount Decimal            @default(0) @db.Decimal(10, 2) @map("min_purchase_amount")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("influencer_reward_settings")
}

model InfluencerReward {
  id                  String         @id @default(uuid())
  influencerId        String         @map("influencer_id")
  usageId             String         @unique @map("usage_id")
  walletTransactionId String?        @unique @map("wallet_transaction_id")
  rewardAmount        Decimal        @db.Decimal(10, 2) @map("reward_amount")
  status              ReferralStatus @default(REWARDED)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  influencer       Influencer    @relation(fields: [influencerId], references: [id])
  usage            DiscountUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)
  walletTransaction Transaction?  @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([influencerId])
  @@map("influencer_rewards")
}

// ─── Referral System ─────────────────────────────────────────────────────────

model ReferralSettings {
  id               String             @id @default(uuid())
  isActive         Boolean            @default(false) @map("is_active")
  rewardType       ReferralRewardType @default(FIXED) @map("reward_type")
  rewardValue      Decimal            @db.Decimal(10, 2) @map("reward_value")
  minDepositAmount Decimal            @default(0) @db.Decimal(10, 2) @map("min_deposit_amount")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("referral_settings")
}

model ReferralCode {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  code        String   @unique
  totalUses   Int      @default(0) @map("total_uses")
  totalEarned Decimal  @default(0) @db.Decimal(10, 2) @map("total_earned")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[] @relation("ReferrerCode")

  @@map("referral_codes")
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String         @map("referrer_id")
  referredId   String         @unique @map("referred_id") // one referral per user
  code         String
  status       ReferralStatus @default(PENDING)
  rewardAmount Decimal?       @db.Decimal(10, 2) @map("reward_amount")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  referrer     User         @relation("ReferrerUser", fields: [referrerId], references: [id])
  referred     User         @relation("ReferredUser", fields: [referredId], references: [id])
  referralCode ReferralCode @relation("ReferrerCode", fields: [code], references: [code])

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralCampaignCode {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  signupBonusAmount Decimal  @db.Decimal(10, 2) @map("signup_bonus_amount")
  isActive          Boolean  @default(true) @map("is_active")
  startsAt          DateTime? @map("starts_at")
  expiresAt         DateTime? @map("expires_at")
  maxUses           Int?     @map("max_uses")
  usedCount         Int      @default(0) @map("used_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  usages ReferralCampaignCodeUsage[]

  @@index([isActive])
  @@map("referral_campaign_codes")
}

model ReferralCampaignCodeUsage {
  id             String   @id @default(uuid())
  campaignCodeId String   @map("campaign_code_id")
  userId         String   @unique @map("user_id")
  transactionId  String?  @unique @map("transaction_id")
  bonusAmount    Decimal  @db.Decimal(10, 2) @map("bonus_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  campaignCode ReferralCampaignCode @relation(fields: [campaignCodeId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([campaignCodeId])
  @@map("referral_campaign_code_usages")
}

// ─── Admin Roles & Permissions ──────────────────────────────────────────────────

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions AdminRolePermission[]
  users       User[]

  @@map("admin_roles")
}

model AdminRolePermission {
  id          String    @id @default(uuid())
  adminRoleId String    @map("admin_role_id")
  permission  String

  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, permission])
  @@map("admin_role_permissions")
}

// ─── Job Postings ─────────────────────────────────────────────────────────────

model JobPosting {
  id               String    @id @default(uuid())
  title            String
  type             JobType
  location         String
  description      String    @db.Text
  responsibilities Json                       // string[] — array of bullet points
  isActive         Boolean   @default(false) @map("is_active")
  closingDate      DateTime? @map("closing_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("job_postings")
}

model Staff {
  id                      String                @id @default(uuid())
  name                    String
  staffCode               String                @unique @map("staff_code")
  currentRole             String                @map("current_role")
  locationId              String                @map("location_id")
  email                   String?               @unique
  phone                   String?
  dateOfBirth             DateTime?             @map("date_of_birth")
  employmentStatus        StaffEmploymentStatus @default(ACTIVE) @map("employment_status")
  reasonForExit           String?               @map("reason_for_exit")
  exitDate                DateTime?             @map("exit_date")
  archivedAt              DateTime?             @map("archived_at")
  birthdayLastEmailedYear Int?                 @map("birthday_last_emailed_year")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  location  StaffLocation            @relation(fields: [locationId], references: [id])
  histories StaffEmploymentHistory[]

  @@index([employmentStatus])
  @@index([locationId])
  @@map("staff")
}

model StaffEmploymentHistory {
  id               String              @id @default(uuid())
  staffId          String              @map("staff_id")
  roleTitle        String              @map("role_title")
  locationId       String              @map("location_id")
  employmentType   StaffEmploymentType @default(FULL_TIME) @map("employment_type")
  startDate        DateTime            @map("start_date")
  endDate          DateTime?           @map("end_date")
  reasonForChange  String?             @map("reason_for_change")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  staff    Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location StaffLocation @relation(fields: [locationId], references: [id])

  @@index([staffId, startDate])
  @@index([locationId])
  @@map("staff_employment_history")
}

model BranchService {
  id          String   @id @default(uuid())
  branchId    String   @map("branch_id")
  serviceId   String   @map("service_id")
  isAvailable Boolean  @default(true) @map("is_available")
  walkInPrice Decimal? @db.Decimal(10, 2) @map("walk_in_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch  StaffLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceId])
  @@index([branchId])
  @@index([serviceId])
  @@map("branch_services")
}

model StaffLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff          Staff[]
  histories      StaffEmploymentHistory[]
  branchServices BranchService[]
  bookings       Booking[]

  @@map("staff_locations")
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("waitlist_entries")
}

// ─── Beautician Provider App ───────────────────────────────────────────────────

model BeauticianProfile {
  id                    String               @id @default(uuid())
  userId                String               @unique @map("user_id")
  bio                   String?
  profilePhotoUrl       String?              @map("profile_photo_url")
  specialties           String[]             @default([])
  yearsOfExperience     Int?                 @map("years_of_experience")
  certifications        String[]             @default([])
  currentLat            Decimal?             @db.Decimal(10, 7) @map("current_lat")
  currentLng            Decimal?             @db.Decimal(10, 7) @map("current_lng")
  lastLocationUpdate    DateTime?            @map("last_location_update")
  maxTravelRadiusKm     Decimal?             @db.Decimal(6, 2) @map("max_travel_radius_km")
  availabilityStatus    AvailabilityStatus   @default(OFFLINE) @map("availability_status")
  kycStatus             KycStatus            @default(PENDING) @map("kyc_status")
  kycVerifiedAt         DateTime?            @map("kyc_verified_at")
  qoreIdCustomerId      String?              @map("qore_id_customer_id")
  qoreIdSessionId       String?              @map("qore_id_session_id")
  profileStatus         ProfileReviewStatus  @default(NOT_SUBMITTED) @map("profile_status")
  profileSubmittedAt    DateTime?            @map("profile_submitted_at")
  profileReviewedAt     DateTime?            @map("profile_reviewed_at")
  profileReviewedById   String?              @map("profile_reviewed_by_id")
  reviewNotes           String?              @map("review_notes")
  ratingAverage         Decimal              @default(0) @db.Decimal(3, 2) @map("rating_average")
  totalJobsCompleted    Int                  @default(0) @map("total_jobs_completed")
  totalEarnings         Decimal              @default(0) @db.Decimal(12, 2) @map("total_earnings")
  commissionRateOverride Decimal?            @db.Decimal(5, 4) @map("commission_rate_override")
  payoutBankCode         String?              @map("payout_bank_code")
  payoutAccountNumber    String?              @map("payout_account_number")
  payoutAccountName      String?              @map("payout_account_name")
  paystackRecipientCode  String?              @map("paystack_recipient_code")
  payoutBankVerifiedAt   DateTime?            @map("payout_bank_verified_at")
  isActive              Boolean              @default(true) @map("is_active")
  dispatchSuspended     Boolean              @default(false) @map("dispatch_suspended")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileReviewedBy User?               @relation("ProfileReviewedBy", fields: [profileReviewedById], references: [id], onDelete: SetNull)
  assignedServices  BeauticianService[]

  @@index([kycStatus])
  @@index([profileStatus])
  @@index([availabilityStatus])
  @@index([isActive])
  @@index([dispatchSuspended])
  @@map("beautician_profiles")
}

model BeauticianService {
  id                  String   @id @default(uuid())
  beauticianProfileId String   @map("beautician_profile_id")
  serviceId           String   @map("service_id")
  assignedById        String   @map("assigned_by_id")
  assignedAt          DateTime @default(now()) @map("assigned_at")

  beauticianProfile BeauticianProfile @relation(fields: [beauticianProfileId], references: [id], onDelete: Cascade)
  service           Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignedBy        User              @relation("BeauticianServiceAssignedBy", fields: [assignedById], references: [id])

  @@unique([beauticianProfileId, serviceId])
  @@index([beauticianProfileId])
  @@index([serviceId])
  @@map("beautician_services")
}

model JobOffer {
  id                 String         @id @default(uuid())
  bookingId          String         @map("booking_id")
  beauticianUserId   String         @map("beautician_user_id")
  status             JobOfferStatus @default(OFFERED)
  offeredAt          DateTime       @default(now()) @map("offered_at")
  respondedAt        DateTime?      @map("responded_at")
  expiresAt          DateTime       @map("expires_at")
  distanceKmAtOffer  Decimal?       @db.Decimal(8, 2) @map("distance_km_at_offer")
  estEarningsAtOffer Decimal?       @db.Decimal(10, 2) @map("est_earnings_at_offer")
  tier               Int?           @db.SmallInt
  scoreSnapshot      Json?          @map("score_snapshot")
  declineReason      String?        @map("decline_reason")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  beautician User    @relation(fields: [beauticianUserId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([beauticianUserId])
  @@index([status])
  @@index([expiresAt])
  @@map("job_offers")
}

model BookingCommsSession {
  id               String                    @id @default(uuid())
  bookingId        String                    @unique @map("booking_id")
  streamChannelId  String                    @map("stream_channel_id")
  streamCallCid    String?                   @map("stream_call_cid")
  customerUserId   String                    @map("customer_user_id")
  beauticianUserId String                    @map("beautician_user_id")
  status           BookingCommsSessionStatus
  openedAt         DateTime                  @map("opened_at")
  closedAt         DateTime?                 @map("closed_at")
  closeReason      BookingCommsCloseReason?  @map("close_reason")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  booking Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  events  BookingCommsEvent[]

  @@index([customerUserId])
  @@index([beauticianUserId])
  @@index([status])
  @@index([openedAt])
  @@index([closedAt])
  @@map("booking_comms_sessions")
}

model BookingCommsEvent {
  id             String               @id @default(uuid())
  sessionId      String               @map("session_id")
  eventType      BookingCommsEventType @map("event_type")
  actorUserId    String?              @map("actor_user_id")
  streamEventId  String               @unique @map("stream_event_id")
  payload        Json?
  createdAt      DateTime             @default(now()) @map("created_at")

  session BookingCommsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@map("booking_comms_events")
}

model DispatchEvent {
  id              String   @id @default(uuid())
  bookingId       String   @map("booking_id")
  eventType       String   @map("event_type")
  payload         Json?
  idempotencyKey  String?  @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("dispatch_events")
}

model DispatchConfig {
  id        String   @id @default(uuid())
  region    String   @default("default")
  key       String
  value     String
  valueType String   @default("string") @map("value_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([region, key])
  @@map("dispatch_config")
}

model HomeServiceSettings {
  id                              String     @id @default(uuid())
  commissionRate                    Decimal    @default(0.70) @db.Decimal(5, 4) @map("commission_rate")
  kycAutoApprove                  Boolean    @default(true) @map("kyc_auto_approve")
  arrivalVerificationExpiryMinutes Int       @default(15) @map("arrival_verification_expiry_minutes")
  serviceCompletionBufferMinutes  Int        @default(60) @map("service_completion_buffer_minutes")
  payoutMode                      PayoutMode @default(MANUAL) @map("payout_mode")
  arrivalGeoFenceMeters           Int        @default(250) @map("arrival_geo_fence_meters")
  noShowPenaltyEnabled            Boolean    @default(true) @map("no_show_penalty_enabled")
  noShowSuspendThreshold          Int        @default(3) @map("no_show_suspend_threshold")
  noShowWindowDays                Int        @default(30) @map("no_show_window_days")
  createdAt                       DateTime   @default(now()) @map("created_at")
  updatedAt                       DateTime   @updatedAt @map("updated_at")

  @@map("home_service_settings")
}

model PayoutRequest {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  amount          Decimal             @db.Decimal(10, 2)
  status          PayoutRequestStatus @default(PENDING)
  bankCode        String              @map("bank_code")
  accountNumber   String              @map("account_number")
  accountName     String?             @map("account_name")
  processedById   String?             @map("processed_by_id")
  processedAt     DateTime?           @map("processed_at")
  rejectionReason String?             @map("rejection_reason")
  transactionId   String?             @unique @map("transaction_id")
  paystackTransferReference String?     @unique @map("paystack_transfer_reference")
  paystackTransferCode      String?     @map("paystack_transfer_code")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user        User         @relation("UserPayoutRequests", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User?        @relation("PayoutProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("payout_requests")
}

model FcmToken {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  token      String
  platform   FcmPlatform
  lastUsedAt DateTime    @default(now()) @map("last_used_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("fcm_tokens")
}

model BeauticianLocationHistory {
  id               String   @id @default(uuid())
  beauticianUserId String   @map("beautician_user_id")
  lat              Decimal  @db.Decimal(10, 7)
  lng              Decimal  @db.Decimal(10, 7)
  accuracy         Decimal? @db.Decimal(8, 2)
  bookingId        String?  @map("booking_id")
  recordedAt       DateTime @default(now()) @map("recorded_at")

  beautician User     @relation("BeauticianLocationHistory", fields: [beauticianUserId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([beauticianUserId, recordedAt])
  @@index([bookingId])
  @@map("beautician_location_history")
}
