  serviceId      String   @unique @map("service_id")
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_commission_rates")
}

// ─── Salon customer tracking (lightweight, no auth required) ───
// Deliberately separate from `User` — most walk-in/salon customers never need
// a password-bearing account at all. `userId` is only ever set if a customer
// later chooses to claim a real login to see their booking history; until
// then this just exists to de-duplicate repeat visits by phone number.
model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastKnownLifecycle     String?   @map("last_known_lifecycle")
  lastLifecycleCheckedAt DateTime? @map("last_lifecycle_checked_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  salonBookings SalonBooking[]
  lifecycleTransitions CustomerLifecycleTransition[]
  communicationProfiles CustomerCommunicationProfile[]

  @@map("customers")
}

model CustomerLifecycleTransition {
  id            String    @id @default(uuid())
  customerId    String?   @map("customer_id")
  userId        String?   @map("user_id")
  fromLifecycle String    @map("from_lifecycle")
  toLifecycle   String    @map("to_lifecycle")
  detectedAt    DateTime  @default(now()) @map("detected_at")
  processedAt   DateTime? @map("processed_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sends    LifecycleCampaignSend[]
  sequenceSends LifecycleCampaignSequenceSend[]

  @@index([customerId])
  @@index([userId])
  @@index([processedAt])
  @@map("customer_lifecycle_transitions")
}

/**
 * One row per (subject, channel) -- exactly one of customerId/userId set,
 * same pattern as CustomerLifecycleTransition. Owns ONLY consent/opt-out
 * state, which can't be derived from anything else -- deliberately does
 * NOT store channel "availability" (do they have a valid email/phone/push
 * token right now), since that's already on User.email/phone or
 * Customer.email/phone and would just go stale duplicated here; the send
 * pipeline checks availability directly against those fields at send time.
 *
 * marketingConsent's default is CHANNEL-SPECIFIC and decided by
 * application code at row-creation time, not a DB column default (a
 * single column can't vary its default by another column's value):
 * EMAIL and PUSH default to true (an existing customer relationship, or
 * an explicit OS-level notification-permission grant, already implies
 * consent); SMS defaults to false (more intrusive, real per-message
 * cost -- requires an explicit opt-in).
 */
model CustomerCommunicationProfile {
  id               String               @id @default(uuid())
  customerId       String?              @map("customer_id")
  userId           String?              @map("user_id")
  channel          CommunicationChannel
  marketingConsent Boolean              @map("marketing_consent")
  optedOutAt       DateTime?            @map("opted_out_at")
  optedOutReason   String?              @map("opted_out_reason")
  lastDeliveryStatus String?            @map("last_delivery_status")
  lastDeliveredAt  DateTime?            @map("last_delivered_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerId, channel])
  @@unique([userId, channel])
  @@index([customerId])
  @@index([userId])
  @@map("customer_communication_profiles")
}

/**
 * One row per (targetLifecycle, channel) -- keyed by the "to" state a
 * transition landed on, not the full (from, to) pair (see build-order
 * discussion: message content is about where someone ended up, not where
 * they came from). targetLifecycle stays a plain String, matching
 * CustomerLifecycleTransition's fromLifecycle/toLifecycle -- avoids a
 * second, parallel enum drifting from classifyCustomerLifecycle's
 * existing TS union type. delayDays/cooldownDays are the "timing/
 * frequency" config the send pipeline (not yet built) will read:
 * delayDays = how long after detection to send; cooldownDays = minimum
 * gap before this same template can send to the same subject again, so
 * someone oscillating between two lifecycle states isn't re-messaged
 * every single time.
 */
model LifecycleCampaignTemplate {
  id             String               @id @default(uuid())
  targetLifecycle String              @map("target_lifecycle")
  channel        CommunicationChannel
  isEnabled      Boolean              @default(true) @map("is_enabled")
  subject        String?              // EMAIL only
  bodyTemplate   String               @map("body_template") // supports {{firstName}}, {{lastName}}, {{lastVisitDate}}
  delayDays      Int                  @default(0) @map("delay_days")
  cooldownDays   Int                  @default(30) @map("cooldown_days")
  sendHour       Int?                 @map("send_hour") // 0-23, local server time
  sendMinute     Int?                 @map("send_minute") // 0-59
  // Dev Feedback Round 6, item #12. Both independent, optional
  // audience-narrowing filters on top of targetLifecycle -- null means
  // "no restriction on this dimension" (matches every value / every
  // source), same convention as sendHour meaning "no time restriction".
  // targetValue is a plain string, not a Prisma enum, mirroring how
  // targetLifecycle itself is stored -- both are validated against the
  // CustomerLifecycle/CustomerValue TS union types in
  // src/common/utils/customer-status.util.ts via class-validator's
  // @IsIn, not a DB-level enum constraint.
  targetValue    String?              @map("target_value") // STANDARD | PREMIUM | VIP
  audienceSource String?              @map("audience_source") // USER | CUSTOMER
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([targetLifecycle, channel])
  @@map("lifecycle_campaign_templates")

  sends LifecycleCampaignSend[]
  targetingDiscountCodes DiscountCode[]
  usedInSequenceSteps LifecycleCampaignSequenceStep[]
}

/**
 * Dev Feedback Round 4, item #9: sequential, multi-step campaigns
 * (e.g. Email -> SMS -> Push, each delayed relative to the PREVIOUS
 * step actually sending, not relative to the lifecycle transition
 * itself). Deliberately additive, not a replacement for
 * LifecycleCampaignTemplate -- a lifecycle stage can have independent,
 * parallel single-channel templates (existing system, untouched) AND/OR
 * one sequence (this new system); both fire from the same
 * CustomerLifecycleTransition trigger, tracked and cooled-down
 * independently of each other.
 */
model LifecycleCampaignSequence {
  id              String   @id @default(uuid())
  targetLifecycle String   @map("target_lifecycle")
  name            String   // admin-facing label, e.g. "At-Risk Re-engagement Sequence"
  isEnabled       Boolean  @default(true) @map("is_enabled")
  cooldownDays    Int      @default(30) @map("cooldown_days")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  steps LifecycleCampaignSequenceStep[]
  sends LifecycleCampaignSequenceSend[]
  targetingDiscountCodes DiscountCode[]

  @@index([targetLifecycle, isEnabled])
  @@map("lifecycle_campaign_sequences")
}

model LifecycleCampaignSequenceStep {
  id       String               @id @default(uuid())
  sequenceId String             @map("sequence_id")
  stepOrder  Int                @map("step_order") // 1, 2, 3... execution order
  // Dev Feedback Round 6, item #13: a step now selects an existing
  // LifecycleCampaignTemplate rather than re-entering channel/subject/
  // message per step -- content (and channel) is resolved from the
  // linked template at send time, so an edit to the template
  // automatically applies to every sequence step referencing it.
  // channel/subject/bodyTemplate below are now nullable and unused by
  // new steps -- kept in place (not dropped) only so any pre-existing
  // step rows created before this change still have a valid row shape;
  // the DTO requires templateId for every step going forward.
  templateId String?            @map("template_id")
  channel    CommunicationChannel?
  subject    String?            // EMAIL only, same convention as LifecycleCampaignTemplate
  bodyTemplate String?          @map("body_template")
  delayAfterPreviousMinutes Int @default(0) @map("delay_after_previous_minutes")
  sendHour   Int?               @map("send_hour")
  sendMinute Int?               @map("send_minute")
  createdAt  DateTime           @default(now()) @map("created_at")

  sequence LifecycleCampaignSequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template LifecycleCampaignTemplate?      @relation(fields: [templateId], references: [id])
  sends    LifecycleCampaignSequenceSend[]

  @@unique([sequenceId, stepOrder])
  @@map("lifecycle_campaign_sequence_steps")
}

/** Mirrors LifecycleCampaignSend's role exactly, one row per (transition, step) send attempt. */
model LifecycleCampaignSequenceSend {
  id           String    @id @default(uuid())
  transitionId String    @map("transition_id")
  sequenceId   String    @map("sequence_id")
  stepId       String    @map("step_id")
  status       String    // SENT | SKIPPED_NO_CONSENT | SKIPPED_NO_CONTACT | SKIPPED_NO_TEMPLATE | SKIPPED_COOLDOWN | SKIPPED_SEQUENCE_DISABLED | SKIPPED_PREVIOUS_STEP_NOT_SENT | FAILED
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  transition CustomerLifecycleTransition   @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  sequence   LifecycleCampaignSequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  step       LifecycleCampaignSequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([transitionId, stepId])
  @@index([stepId, status])
  @@map("lifecycle_campaign_sequence_sends")
}

/**
 * One row per (transition, template) SEND ATTEMPT -- not per transition.
 * Needed because a single transition can match up to 3 templates (one per
 * channel), each with its own independent delayDays; a single processedAt
 * flag on the transition can't represent "email already sent, SMS still
 * waiting on its delay window" without this. The cooldown check reads
 * status='SENT' rows here specifically -- a SKIPPED attempt (no consent,
 * no contact info, etc.) must never satisfy a future cooldown check, only
 * an actual send does.
 */
model LifecycleCampaignSend {
  id           String    @id @default(uuid())
  transitionId String    @map("transition_id")
  templateId   String    @map("template_id")
  status       String    // SENT | SKIPPED_NO_CONSENT | SKIPPED_NO_CONTACT | SKIPPED_COOLDOWN | SKIPPED_TEMPLATE_DISABLED | FAILED
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  transition CustomerLifecycleTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  template   LifecycleCampaignTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([transitionId, templateId])
  @@index([templateId, status])
  @@map("lifecycle_campaign_sends")
}

model Booking {
  id                       String                   @id @default(uuid())
  userId                   String                   @map("user_id")
  // services is a JSON array: [{serviceId, name, price, quantity, duration, notes?, serviceMode?}]
  services                 Json                     @map("services")
  addressId                String?                  @map("address_id") // null for WALK_IN-only bookings
  // Temporary / current-location alternative to a saved addressId (HOME_SERVICE)
  tempLatitude             Decimal?                 @map("temp_latitude") @db.Decimal(10, 7)
  tempLongitude            Decimal?                 @map("temp_longitude") @db.Decimal(10, 7)
  tempFullAddress          String?                  @map("temp_full_address") // human-readable string
  branchId                 String?                  @map("branch_id")
  bookingDate              DateTime                 @map("booking_date")
  bookingTime              String                   @map("booking_time") // Format: "HH:mm"
  bookingType              BookingType              @default(HOME_SERVICE) @map("booking_type")
  reservationCode          String                   @unique @map("reservation_code")
  reservationUsed          Boolean                  @default(false) @map("reservation_used")
  guestName                String?                  @map("guest_name") // null = booking for self
  guestPhone               String?                  @map("guest_phone") // null = booking for self
  guestEmail               String?                  @map("guest_email") // if set, notification email sent to guest
  idempotencyKey           String?                  @map("idempotency_key")
  status                   BookingStatus            @default(PENDING)
  paymentMethod            PaymentMethod            @map("payment_method")
  totalAmount              Decimal                  @map("total_amount") @db.Decimal(10, 2)
  notes                    String?
  cancelReason             String?                  @map("cancel_reason")
  assignedBeauticianUserId String?                  @map("assigned_beautician_user_id")
  // Which in-house Stylist actually served the customer — set when staff
  // verify a WALK_IN reservation in-salon. Deliberately separate from
  // assignedBeauticianUserId (marketplace dispatch, points at a Beautician's
  // User account) — this points at Staff, for salon walk-ins only.
  assignedInHouseStaffId   String?                  @map("assigned_in_house_staff_id")
  arrivalVerifiedAt        DateTime?                @map("arrival_verified_at")
  serviceStartedAt         DateTime?                @map("service_started_at")
  serviceCompletedAt       DateTime?                @map("service_completed_at")
  beauticianArrivalLat     Decimal?                 @map("beautician_arrival_lat") @db.Decimal(10, 7)
  beauticianArrivalLng     Decimal?                 @map("beautician_arrival_lng") @db.Decimal(10, 7)
  customerRating           Int?                     @map("customer_rating")
  customerReview           String?                  @map("customer_review")
  matchingAttempt          Int                      @default(1) @map("matching_attempt")
  matchingStartedAt        DateTime?                @map("matching_started_at")
  matchingExhaustedAt      DateTime?                @map("matching_exhausted_at")
  matchingExhaustedReason  MatchingExhaustedReason? @map("matching_exhausted_reason")
  dispatchStatus           DispatchStatus?          @map("dispatch_status")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  // Relations
  user                 User                        @relation(fields: [userId], references: [id])
  address              Address?                    @relation(fields: [addressId], references: [id])
  branch               StaffLocation?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedBeautician   User?                       @relation("AssignedBeautician", fields: [assignedBeauticianUserId], references: [id], onDelete: SetNull)
  assignedInHouseStaff Staff?                      @relation("BookingAssignedInHouseStaff", fields: [assignedInHouseStaffId], references: [id], onDelete: SetNull)
  review               Review?
  discountUsage        DiscountUsage?
  jobOffers            JobOffer[]
  dispatchEvents       DispatchEvent[]
  locationHistory      BeauticianLocationHistory[]
  commsSession         BookingCommsSession?

  @@unique([userId, idempotencyKey])
  @@index([reservationCode])
  @@index([userId])
  @@index([status])
  @@index([bookingDate])
  @@index([userId, status])
  @@index([assignedBeauticianUserId])
  @@index([assignedInHouseStaffId])
  @@map("bookings")
}

// ─── In-salon staff bookings (Front Desk / walk-in) ───
// Deliberately separate from the marketplace `Booking` model above, which is
// tied to customer app accounts, GPS dispatch, and beautician job-matching —
// none of which applies when Front Desk directly books a walk-in customer
// and assigns an on-site Stylist. This is the SRS's Sales & Bookings module.

model SalonBooking {
  id                String              @id @default(uuid())
  bookingNumber     Int                 @default(autoincrement()) @map("booking_number") // Display as "HLB-" + zero-padded (e.g. HLB-001057) at the API/frontend layer — the raw integer here is what's actually unique/sequential
  branchId        String             @map("branch_id")
  customerId      String?            @map("customer_id")
  customerName    String             @map("customer_name")
  customerPhone   String?            @map("customer_phone")
  assignedStaffId String?            @map("assigned_staff_id")
  createdById     String?            @map("created_by_id")
  bookingDate     DateTime           @map("booking_date") @db.Date
  bookingTime     String             @map("booking_time") // "HH:mm"
  status          SalonBookingStatus @default(SCHEDULED)
  totalAmount     Decimal            @default(0) @map("total_amount") @db.Decimal(10, 2)
  notes           String?
  cancelReason    String?            @map("cancel_reason")
  completedAt     DateTime?          @map("completed_at")
  cancelledAt     DateTime?          @map("cancelled_at")
  reservationCode String?            @unique @map("reservation_code")
  reservationUsed Boolean            @default(false) @map("reservation_used")
  // Dev Feedback Round 6, item #15: coupon redemption for walk-in
  // customers. One coupon per booking, matching the marketplace side's
  // own constraint (DiscountUsage.bookingId is unique there too) --
  // just direct fields here rather than a separate usage model, since
  // there's no need to track more than "which code, how much off".
  discountCodeId  String?            @map("discount_code_id")
  discountAmount  Decimal?           @map("discount_amount") @db.Decimal(10, 2)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  branch         StaffLocation               @relation(fields: [branchId], references: [id])
  customer       Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedStaff  Staff?                      @relation("SalonBookingAssignedStaff", fields: [assignedStaffId], references: [id])
  createdBy      Staff?                      @relation("SalonBookingCreatedBy", fields: [createdById], references: [id])
  services       SalonBookingService[]
  inventoryItems SalonBookingInventoryItem[]
  discountCode   DiscountCode?               @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  commission     SalonBookingCommission?

  @@index([branchId, bookingDate])
  @@index([assignedStaffId, status])
  @@map("salon_bookings")
}

// Services included in a booking — price is snapshotted at booking time so a
// later change to Service.walkInPrice never retroactively alters a past bill.
model SalonBookingService {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  serviceId String  @map("service_id")
  price     Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  booking SalonBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@map("salon_booking_services")
}

// Inventory items used or sold as part of a booking. unitPrice is only set
// for sellable (category = FOR_SALE) items and is what feeds totalAmount;
// non-sellable items still deduct stock (as CONSUMED) but don't bill the
// customer.
model SalonBookingInventoryItem {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  itemId    String   @map("item_id")
  quantity  Int
  unitPrice Decimal? @map("unit_price") @db.Decimal(10, 2)
  // Phase 8: same cost-basis snapshot as ProductSaleItem.unitCost -- a
  // product sold during a booking is still a genuine product sale for
  // profitability-reporting purposes, and should count the same way.
  // Only meaningful alongside unitPrice (sellable, FOR_SALE lines);
  // non-billed CONSUMED lines have no revenue to net a cost against.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  booking SalonBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@index([bookingId])
  @@map("salon_booking_inventory_items")
}

// One row per completed booking, enforced by the unique constraint on
// bookingId — mirrors the idempotency rule from the SRS's Commission module.
/// Payroll Developer Implementation Guide, section 11. A reusable, named
/// commission template -- staff members reference one via
/// Staff.commissionPlanId, so the same plan can be shared across a role or
/// branch, or a staff member can have their own dedicated one. Deliberately
/// carries no creator/updater fields of its own: SystemAuditLog already
/// captures who changed a plan and when, and every actual commission
/// record this plan produces freezes its own rate/eligibility at
/// calculation time (SalonBookingCommission.rateApplied), so the plan
/// itself never needs to answer "what rate did we use historically" --
/// only "what rate applies going forward."
model CommissionPlan {
  id   String @id @default(uuid())
  name String

  commissionRate Decimal @map("commission_rate") @db.Decimal(5, 4) // percentage as decimal, e.g. 0.15 = 15%

  /// Which services generate commission under this plan. Empty array means
  /// every service is eligible -- matches the DiscountCode.targetBranchIds
  /// convention already used elsewhere in this schema (empty = no
  /// restriction), rather than requiring an explicit "all services"
  /// sentinel value.
  eligibleServiceIds String[] @map("eligible_service_ids")

  /// Optional scoping -- null means this plan isn't restricted to a
  /// specific branch/role, so it can be assigned to any staff member
  /// regardless of where they work or what role they hold.
  applicableBranchId String? @map("applicable_branch_id")
  applicableRole     String? @map("applicable_role")

  effectiveDate DateTime @map("effective_date") @db.Date

  /// "Only approved eligible transactions generate commission" -- when
  /// true, a SalonBookingCommission produced under this plan starts in a
  /// pending state and needs explicit admin approval before it's included
  /// in payroll; when false, eligible transactions count automatically.
  requiresApproval Boolean @default(false) @map("requires_approval")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applicableBranch StaffLocation? @relation(fields: [applicableBranchId], references: [id], onDelete: SetNull)
  assignedStaff    Staff[]        @relation("StaffCommissionPlan")
  commissions      SalonBookingCommission[]
  payslipsUsedOn   Payslip[]

  @@index([applicableBranchId])
  @@index([isActive])
  @@map("commission_plans")
}

model SalonBookingCommission {
  id           String   @id @default(uuid())
  bookingId    String   @unique @map("booking_id")
  staffId      String   @map("staff_id")
  amount       Decimal  @db.Decimal(10, 2)
  rateApplied  Decimal  @map("rate_applied") @db.Decimal(5, 4)
  calculatedAt DateTime @default(now()) @map("calculated_at")

  /// Nullable -- older records predating this feature, and any commission
  /// still coming from a staff member's plain Staff.commissionRate rather
  /// than a formal plan, won't have one.
  commissionPlanId String? @map("commission_plan_id")

  /// Payroll Developer Implementation Guide, section 11: "only approved
  /// eligible transactions generate commission" -- when the applied plan
  /// has requiresApproval set, this starts PENDING and an admin must
  /// approve it before payroll will count it; when the plan doesn't
  /// require approval (or there's no plan at all, i.e. the plain
  /// Staff.commissionRate path), it's created already APPROVED.
  approvalStatus  ApprovalStatus @default(APPROVED) @map("approval_status")
  approvedById    String?                    @map("approved_by_id")
  approvedAt      DateTime?                  @map("approved_at")

  booking        SalonBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff          Staff           @relation("SalonBookingCommissionStaff", fields: [staffId], references: [id])
  commissionPlan CommissionPlan? @relation(fields: [commissionPlanId], references: [id], onDelete: SetNull)
  approvedBy     Staff?          @relation("SalonBookingCommissionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([staffId, calculatedAt])
  @@index([commissionPlanId])
  @@index([approvalStatus])
  @@map("salon_booking_commissions")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id            String                   @id @default(uuid())
  walletId      String                   @map("wallet_id")
  type          TransactionType
  amount        Decimal                  @db.Decimal(10, 2)
  status        TransactionStatus        @default(PENDING)
  paymentMethod TransactionPaymentMethod @default(WALLET) @map("payment_method")
  reference     String                   @unique // Payment gateway reference or internal ref
  description   String?
  metadata      Json? // Store additional payment details
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  // Relations
  wallet                Wallet                     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  influencerReward      InfluencerReward?
  referralCampaignUsage ReferralCampaignCodeUsage?
  payoutRequest         PayoutRequest?

  @@index([walletId])
  @@index([walletId, status])
  @@map("transactions")
}

model Review {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  serviceId String       @map("service_id")
  bookingId String       @unique @map("booking_id")
  rating    Int // 1-5
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@map("reviews")
}

// HCS CRM & Retention Engine — VIP/Premium spend thresholds must be
// admin-configurable, not hard-coded, per spec. Single-row settings table,
// same pattern as BusinessSettings.
// Despite the name (kept as-is to avoid touching every existing
// prisma.customerValueSettings reference across the codebase), this single
// row now holds BOTH Value thresholds (spend-based) AND Lifecycle
// thresholds (day/visit-count-based) — the two independent CRM
// classification dimensions share one admin-configurable settings row.
model CustomerValueSettings {
  id                    String   @id @default(uuid())
  premiumSpendThreshold Decimal  @default(50000) @map("premium_spend_threshold") @db.Decimal(10, 2)
  vipSpendThreshold     Decimal  @default(200000) @map("vip_spend_threshold") @db.Decimal(10, 2)

  // Lifecycle thresholds — see classifyCustomerLifecycle for exactly how
  // each is applied. newAccountAgeDays/newVisitCountThreshold gate the NEW
  // bucket; activeDaysThreshold/atRiskDaysThreshold/dormantDaysThreshold
  // are the days-since-last-visit cutoffs for ACTIVE/AT_RISK/DORMANT
  // (anything beyond dormantDaysThreshold is INACTIVE).
  newAccountAgeDays      Int @default(30) @map("new_account_age_days")
  newVisitCountThreshold Int @default(3) @map("new_visit_count_threshold")
  activeDaysThreshold    Int @default(30) @map("active_days_threshold")
  atRiskDaysThreshold    Int @default(90) @map("at_risk_days_threshold")
  dormantDaysThreshold   Int @default(180) @map("dormant_days_threshold")

  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("customer_value_settings")
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  businessName       String   @map("business_name")
  email              String
  phone              String
  address            String
  slotDuration       Int      @default(30) @map("slot_duration") // Booking slot length in minutes
  advanceBookingDays Int      @default(30) @map("advance_booking_days") // How many days ahead bookings allowed
  minNoticeHours     Int      @default(2) @map("min_notice_hours") // Minimum hours before a booking
  maxBookingsPerDay  Int      @default(10) @map("max_bookings_per_day")
  bookingPolicy      String?  @map("booking_policy")
  cancellationPolicy String?  @map("cancellation_policy")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model BusinessHours {
  id        String   @id @default(uuid())
  dayOfWeek Int      @unique @map("day_of_week") // 0=Sunday, 1=Monday ... 6=Saturday
  openTime  String   @map("open_time") // Format: "HH:mm"
  closeTime String   @map("close_time") // Format: "HH:mm"
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_hours")
}

// HCS v1.0 Part B, Phase 4 — branchId null means company-wide (the original
// behavior, unchanged); a set branchId scopes the exception to just that
// branch. No DB-level unique constraint on (date, branchId): Postgres
// treats NULL as distinct in unique indexes, so it can't correctly express
// "one company-wide row per date" — that's enforced in application code
// instead (see AvailabilityService.createBusinessException), scoped
// separately per branchId value.
model BusinessException {
  id        String   @id @default(uuid())
  date      DateTime // Specific calendar date
  branchId  String?  @map("branch_id")
  isClosed  Boolean  @default(true) @map("is_closed")
  openTime  String?  @map("open_time") // Override open time (only if not closed)
  closeTime String?  @map("close_time") // Override close time (only if not closed)
  reason    String? // e.g. "Christmas Holiday"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch StaffLocation? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([branchId, date])
  @@map("business_exceptions")
}

model Influencer {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id") // linked user account
  notes     String? // internal admin notes
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountCodes     DiscountCode[]
  influencerRewards InfluencerReward[]

  @@map("influencers")
}

model DiscountCode {
  id           String       @id @default(uuid())
  code         String       @unique // e.g. "SUMMER20" — case-insensitive at app level
  name         String // e.g. "Summer Sale"
  percentage   Float // e.g. 20.0 (represents 20%)
  type         DiscountType @default(GENERAL) @map("type")
  influencerId String?      @map("influencer_id") // null for GENERAL codes
  isActive     Boolean      @default(true) @map("is_active")
  startsAt     DateTime?    @map("starts_at") // null = active immediately
  expiresAt    DateTime?    @map("expires_at") // null = never expires
  maxUses      Int?         @map("max_uses") // null = unlimited
  usedCount    Int          @default(0) @map("used_count")

  // Dev Feedback Round 4, item #10: targeting. Every dimension defaults to
  // "no restriction" (empty array / null) -- an untouched coupon behaves
  // exactly as before. Multiple set dimensions combine with AND, not OR
  // (e.g. targetBranchIds + targetValueTiers both set means BOTH must
  // match) -- the more filters an admin adds, the narrower the audience,
  // matching how filters combine everywhere else in this codebase.
  targetBranchIds       String[] @default([]) @map("target_branch_ids")
  targetLifecycleStages String[] @default([]) @map("target_lifecycle_stages")
  targetValueTiers      String[] @default([]) @map("target_value_tiers")
  // Gates redemption to people who actually RECEIVED (a SENT status row
  // exists) this specific template/sequence -- not just "currently
  // matches its target lifecycle stage". SetNull on delete: a coupon
  // whose gating template/sequence is later deleted reverts to
  // ungated-by-campaign rather than blocking that deletion or being
  // silently deleted itself.
  targetCampaignTemplateId String? @map("target_campaign_template_id")
  targetCampaignSequenceId String? @map("target_campaign_sequence_id")

  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  influencer Influencer?     @relation(fields: [influencerId], references: [id], onDelete: SetNull)
  usages     DiscountUsage[]
  salonBookings SalonBooking[]
  targetCampaignTemplate LifecycleCampaignTemplate? @relation(fields: [targetCampaignTemplateId], references: [id], onDelete: SetNull)
  targetCampaignSequence LifecycleCampaignSequence? @relation(fields: [targetCampaignSequenceId], references: [id], onDelete: SetNull)

  @@index([influencerId])
  @@index([targetCampaignTemplateId])
  @@index([targetCampaignSequenceId])
  @@map("discount_codes")
}

model DiscountUsage {
  id             String   @id @default(uuid())
  discountCodeId String   @map("discount_code_id")
  userId         String   @map("user_id")
  bookingId      String   @unique @map("booking_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  discountCode     DiscountCode      @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  user             User              @relation("UserDiscountUsages", fields: [userId], references: [id])
  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  influencerReward InfluencerReward?

  @@index([discountCodeId])
  @@index([userId])
  @@map("discount_usages")
}

model InfluencerRewardSettings {
  id                String             @id @default(uuid())
  isActive          Boolean            @default(false) @map("is_active")
  rewardType        ReferralRewardType @default(FIXED) @map("reward_type")
  rewardValue       Decimal            @default(0) @map("reward_value") @db.Decimal(10, 2)
  minPurchaseAmount Decimal            @default(0) @map("min_purchase_amount") @db.Decimal(10, 2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("influencer_reward_settings")
}

model InfluencerReward {
  id                  String         @id @default(uuid())
  influencerId        String         @map("influencer_id")
  usageId             String         @unique @map("usage_id")
  walletTransactionId String?        @unique @map("wallet_transaction_id")
  rewardAmount        Decimal        @map("reward_amount") @db.Decimal(10, 2)
  status              ReferralStatus @default(REWARDED)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // Relations
  influencer        Influencer    @relation(fields: [influencerId], references: [id])
  usage             DiscountUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)
  walletTransaction Transaction?  @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([influencerId])
  @@map("influencer_rewards")
}

// ─── Referral System ─────────────────────────────────────────────────────────

model ReferralSettings {
  id               String             @id @default(uuid())
  isActive         Boolean            @default(false) @map("is_active")
  rewardType       ReferralRewardType @default(FIXED) @map("reward_type")
  rewardValue      Decimal            @map("reward_value") @db.Decimal(10, 2)
  minDepositAmount Decimal            @default(0) @map("min_deposit_amount") @db.Decimal(10, 2)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("referral_settings")
}

// Grace-period minutes stay where they already lived (StaffLocation /
// Staff.lateGracePeriodOverride) — this only adds the missing piece: what a
// minute of lateness beyond the grace period actually costs. Singleton row,
// same access pattern as ReferralSettings.
model LatePenaltySettings {
  id              String   @id @default(uuid())
  isActive        Boolean  @default(false) @map("is_active")
  amountPerMinute Decimal  @default(0) @map("amount_per_minute") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("late_penalty_settings")
}

model ReferralCode {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  code        String   @unique
  totalUses   Int      @default(0) @map("total_uses")
  totalEarned Decimal  @default(0) @map("total_earned") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[] @relation("ReferrerCode")

  @@map("referral_codes")
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String         @map("referrer_id")
  referredId   String         @unique @map("referred_id") // one referral per user
  code         String
  status       ReferralStatus @default(PENDING)
  rewardAmount Decimal?       @map("reward_amount") @db.Decimal(10, 2)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Relations
  referrer     User         @relation("ReferrerUser", fields: [referrerId], references: [id])
  referred     User         @relation("ReferredUser", fields: [referredId], references: [id])
  referralCode ReferralCode @relation("ReferrerCode", fields: [code], references: [code])

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralCampaignCode {
  id                String    @id @default(uuid())
  code              String    @unique
  name              String
  description       String?
  signupBonusAmount Decimal   @map("signup_bonus_amount") @db.Decimal(10, 2)
  isActive          Boolean   @default(true) @map("is_active")
  startsAt          DateTime? @map("starts_at")
  expiresAt         DateTime? @map("expires_at")
  maxUses           Int?      @map("max_uses")
  usedCount         Int       @default(0) @map("used_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  usages ReferralCampaignCodeUsage[]

  @@index([isActive])
  @@map("referral_campaign_codes")
}

model ReferralCampaignCodeUsage {
  id             String   @id @default(uuid())
  campaignCodeId String   @map("campaign_code_id")
  userId         String   @unique @map("user_id")
  transactionId  String?  @unique @map("transaction_id")
  bonusAmount    Decimal  @map("bonus_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  campaignCode ReferralCampaignCode @relation(fields: [campaignCodeId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([campaignCodeId])
  @@map("referral_campaign_code_usages")
}

// ─── Admin Roles & Permissions ──────────────────────────────────────────────────

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions     AdminRolePermission[]
  users           User[]
  additionalUsers UserAdminRole[]       @relation("UserAdminRoleRole")
  auditLogs       RoleAuditLog[]
  lmsCourseRoles  LmsCourseRole[]
  approvalChainStages    ApprovalChainStage[]
  currentStageForRequests ApprovalRequest[]

  @@map("admin_roles")
}

model AdminRolePermission {
  id          String @id @default(uuid())
  adminRoleId String @map("admin_role_id")
  permission  String

  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, permission])
  @@map("admin_role_permissions")
}


model LmsCourse {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text // rich text/HTML from Quill
  videoKey    String?  @map("video_key")
  pdfKey      String?  @map("pdf_key")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  roles     LmsCourseRole[]

  @@index([isActive])
  @@map("lms_courses")
}

model LmsCourseRole {
  id          String @id @default(uuid())
  courseId    String @map("course_id")
  adminRoleId String @map("admin_role_id")

  course    LmsCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([courseId, adminRoleId])
  @@index([adminRoleId])
  @@map("lms_course_roles")
}

// A user's SECONDARY roles, on top of the single primary User.adminRoleId —
// kept as an addition rather than replacing the primary FK outright, since
// a lot of existing code reads User.adminRoleId directly and a big-bang
// migration to pure many-to-many would risk breaking things that don't
// need to break. Effective permissions are the union of the primary role's
// permissions plus every active role in this table.
model UserAdminRole {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  adminRoleId  String   @map("admin_role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id")

  user       User      @relation("UserAdminRoles", fields: [userId], references: [id], onDelete: Cascade)
  adminRole  AdminRole @relation("UserAdminRoleRole", fields: [adminRoleId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("UserAdminRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, adminRoleId])
  @@index([userId])
  @@map("user_admin_roles")
}

enum RoleAuditAction {
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  PERMISSIONS_CHANGED
  USER_ROLE_ASSIGNED // primary role set/changed on a User
  USER_ROLE_ADDED // secondary role added via UserAdminRole
  USER_ROLE_REMOVED // secondary role removed via UserAdminRole
}

// Every role/permission change, across the whole Roles & Permissions
// system — one consistent audit trail rather than a separate log per
// action type. adminRoleId is nullable so a record survives the role
// itself being deleted later (SetNull, not Cascade).
model RoleAuditLog {
  id           String          @id @default(uuid())
  action       RoleAuditAction
  adminRoleId  String?         @map("admin_role_id")
  roleName     String          @map("role_name") // snapshot — survives role deletion or rename
  targetUserId String?         @map("target_user_id") // set for USER_ROLE_* actions
  actorId      String?         @map("actor_id") // nullable — a system/seed action has no human actor
  before       Json?
  after        Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  adminRole  AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  targetUser User?      @relation("RoleAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  actor      User?      @relation("RoleAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([adminRoleId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("role_audit_logs")
}

// ─── Job Postings ─────────────────────────────────────────────────────────────

model JobPosting {
  id               String           @id @default(uuid())
  title            String
  type             JobType
  location         String // display-only text (e.g. "Lagos, Nigeria") — separate from branchId
  branchId         String?          @map("branch_id") // nullable = open to any/all branches
  department       String?
  description      String           @db.Text
  responsibilities Json
  status           JobPostingStatus @default(DRAFT)
  closingDate      DateTime?        @map("closing_date")
  closedReason     String?          @map("closed_reason") // required when closing with active candidates (override case)
  salaryMin        Decimal?         @map("salary_min") @db.Decimal(10, 2)
  salaryMax        Decimal?         @map("salary_max") @db.Decimal(10, 2)
  salaryNote       String?          @map("salary_note") // e.g. "negotiable", "+ commission"
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  branch       StaffLocation?     @relation("JobPostingPrimaryBranch", fields: [branchId], references: [id], onDelete: SetNull)
  branches     JobPostingBranch[]
  applications Application[]      @relation("ApplicationJobPosting")
  offerLetters OfferLetter[]

  @@index([status])
  @@index([branchId])
  @@map("job_postings")
}

// Multi-branch availability for a job posting — the legacy singular
// branchId/location fields above stay as-is for backward compatibility
// with existing data and queries, but new postings created via the admin
// form populate this table instead, supporting more than one branch.
model JobPostingBranch {
  id           String @id @default(uuid())
  jobPostingId String @map("job_posting_id")
  branchId     String @map("branch_id")

  jobPosting JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  branch     StaffLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, branchId])
  @@index([jobPostingId])
  @@index([branchId])
  @@map("job_posting_branches")
}

model Staff {
  id                      String                @id @default(uuid())
  userId                  String?               @unique @map("user_id")
  name                    String
  staffCode               String                @unique @map("staff_code")
  currentRole             String                @map("current_role")
  locationId              String                @map("location_id")
  email                   String?               @unique
  phone                   String?
  dateOfBirth             DateTime?             @map("date_of_birth")
  employmentStatus        StaffEmploymentStatus @default(ACTIVE) @map("employment_status")
  reasonForExit           String?               @map("reason_for_exit")
  exitDate                DateTime?             @map("exit_date")
  archivedAt              DateTime?             @map("archived_at")
  birthdayLastEmailedYear Int?                  @map("birthday_last_emailed_year")

  /// Payroll Developer Implementation Guide, sections 4 and 9: required for
  /// mid-month proration and the SALARY_TO_COMMISSION cutoff calculation.
  /// Deliberately its own explicit field rather than derived from the
  /// earliest StaffEmploymentHistory row -- that model tracks role/location
  /// changes and isn't guaranteed to have an initial row for every staff
  /// member, so deriving from it would be fragile for a figure this
  /// calculation-critical.
  hireDate DateTime? @map("hire_date") @db.Date

  /// Section 9-11: which calculation path applies. Defaults to SALARY
  /// (today's only real path) rather than leaving it nullable, so every
  /// existing staff row has an unambiguous, valid type from the moment
  /// this column exists.
  compensationType CompensationType @default(SALARY) @map("compensation_type")

  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 4) // overrides the service's own rate when set; percentage as decimal e.g. 0.15 = 15%

  /// Payroll Developer Implementation Guide, section 11 -- when set, this
  /// staff member's commission is calculated from the referenced plan's
  /// rate/eligible-services/approval rules instead of the plain
  /// commissionRate above. Nullable: a plan is only meaningful once one
  /// has actually been created and assigned; commissionRate above remains
  /// the fallback for SALARY_PLUS_COMMISSION staff with no formal plan yet.
  commissionPlanId String? @map("commission_plan_id")

  // Fast-read snapshot of current pay — the audited history of changes
  // lives in StaffCompensationHistory. Distinct from OfferLetter.baseSalary,
  // which is a one-time pre-hire snapshot that was never updated after —
  // this is the ongoing figure Payroll actually reads from.
  currentBaseSalary Decimal? @map("current_base_salary") @db.Decimal(10, 2)
  currentAllowances Decimal? @map("current_allowances") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location      StaffLocation            @relation(fields: [locationId], references: [id])
  managedBranch StaffLocation?           @relation("BranchManager")
  // Dev Feedback Round 4, item #25: additive, not a replacement for
  // managedBranch above -- that stays the single "manager of record" for
  // org-chart/reporting purposes. This is a broader, permission-like
  // grant of which branches' finance data a staff member can access,
  // independent of it. A staff member's OWN primary branch (location
  // above) is always accessible without needing a row here at all --
  // this table only needs entries for the EXTRA branches beyond that.
  additionalFinanceBranches StaffManagedFinanceBranch[]
  histories     StaffEmploymentHistory[]
  codeHistory   StaffCodeHistory[]
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  onboardingItems StaffOnboardingItem[]

  documentAcknowledgments StaffDocumentAcknowledgment[]

  responsibilities      String?            @map("responsibilities")
  reportingToId         String?            @map("reporting_to_id")
  reportingTo           Staff?             @relation("StaffReportingLine", fields: [reportingToId], references: [id], onDelete: SetNull)
  directReports         Staff[]            @relation("StaffReportingLine")
  receivedAnnouncements Announcement[]     @relation("AnnouncementTargetStaff")
  announcementReads     AnnouncementRead[]
  directives            Directive[]

  attendanceRecords           AttendanceRecord[]
  lateGracePeriodOverride     Int?                     @map("late_grace_period_override")
  leaveRequests               LeaveRequest[]
  leaveRequestsToApprove      LeaveRequest[]           @relation("LeaveRequestApprover")
  leaveRequestsReassigned     LeaveRequest[]           @relation("LeaveRequestReassignedBy")
  approvalRequestsSubmitted   ApprovalRequest[]        @relation("ApprovalSubmittedBy")
  approvalRequestsToAction    ApprovalRequest[]        @relation("ApprovalCurrentApprover")
  approvalActionsTaken        ApprovalAction[]         @relation("ApprovalActionActor")
  inventoryLogEntries         InventoryLogEntry[]
  stockAdjustmentRequests     StockAdjustmentRequest[]
  disciplinaryActionsReceived DisciplinaryAction[]     @relation("DisciplinaryActionSubject")
  disciplinaryActionsIssued   DisciplinaryAction[]     @relation("DisciplinaryActionIssuedBy")
  salonBookingsAssigned       SalonBooking[]           @relation("SalonBookingAssignedStaff")
  salonBookingsCreated        SalonBooking[]           @relation("SalonBookingCreatedBy")
  salonBookingCommissions     SalonBookingCommission[] @relation("SalonBookingCommissionStaff")
  interviewsConducted         Application[]            @relation("ApplicationInterviewer")

  passportPhotoUrl         String? @map("passport_photo_url")
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")
  guarantorName            String? @map("guarantor_name")
  guarantorOccupation      String? @map("guarantor_occupation")
  guarantorPhone           String? @map("guarantor_phone")
  guarantorAddress         String? @map("guarantor_address")

  address               String? @map("address")
  referenceName         String? @map("reference_name")
  referencePhone        String? @map("reference_phone")
  referenceRelationship String? @map("reference_relationship")

  inventoryMovements       StockMovement[]
  dailyCashReconciliations DailyCashReconciliation[]
  workCalendar             StaffWorkCalendar[]
  llowStockAlertsResolved  LowStockAlert[]
  expiryAlertsResolved     ExpiryAlert[]
  transfersRequested       StockTransfer[]           @relation("TransferRequestedBy")
  transfersApproved        StockTransfer[]           @relation("TransferApprovedBy")
  productSales             ProductSale[]
  bookingsAsInHouseStaff   Booking[]                 @relation("BookingAssignedInHouseStaff")

    bankAccount             StaffBankAccount?
  addressVerification         StaffAddressVerification? @relation("StaffAddressVerification")
  addressVerificationsRequested StaffAddressVerification[] @relation("AddressVerificationRequestedBy")
  purchaseRequestsSubmitted PurchaseRequest[]
  purchasePaymentsRecorded  PurchasePayment[]
  vendorLedgerAdjustmentsCreated VendorLedgerAdjustment[]
  siteStatsUpdates          SiteStats[]
  branchFinanceSettingsUpdates BranchFinanceSettings[]
  goodsReceiptsReceived     GoodsReceipt[]
  compensationHistory     StaffCompensationHistory[] @relation("StaffCompensationHistory")
  compensationChangesMade StaffCompensationHistory[] @relation("CompensationChangedBy")
  payrollPeriodsGenerated PayrollPeriod[]            @relation("PayrollGeneratedBy")
  payrollPeriodsApproved  PayrollPeriod[]            @relation("PayrollApprovedBy")
  payrollPeriodsReleased  PayrollPeriod[]            @relation("PayrollReleasedBy")
  payslips                Payslip[]                  @relation("StaffPayslips")
  payrollAdjustments      PayrollAdjustment[]        @relation("StaffAdjustments")
  payrollAdjustmentsMade  PayrollAdjustment[]        @relation("AdjustmentCreatedBy")
  wallet                  StaffWallet?
  payoutRequests          StaffPayoutRequest[]       @relation("StaffPayoutRequests")
  payoutRequestsProcessed StaffPayoutRequest[]       @relation("StaffPayoutProcessedBy")
  payrollAuditActions     PayrollAuditLog[]          @relation("PayrollAuditActor")
  payrollAuditSubjectOf   PayrollAuditLog[]          @relation("PayrollAuditSubject")
  systemAuditActions      SystemAuditLog[]           @relation("SystemAuditActor")
  systemAuditSubjectOf    SystemAuditLog[]           @relation("SystemAuditSubject")
  commissionPlan             CommissionPlan?           @relation("StaffCommissionPlan", fields: [commissionPlanId], references: [id], onDelete: SetNull)
  approvedCommissions        SalonBookingCommission[]  @relation("SalonBookingCommissionApprovedBy")
  payslipCutoffOverridesMade Payslip[]                 @relation("PayslipCutoffOverrideBy")

  @@index([employmentStatus])
  @@index([locationId])
  @@map("staff")
}

// Every staff code a staff member has ever held — the `code` unique
// constraint means a retired code (from a branch transfer) can never be
// reissued to anyone else. `activeUntil: null` marks the currently-live
// code; a transfer closes the old row and inserts a new one.
model StaffCodeHistory {
  id          String    @id @default(uuid())
  staffId     String    @map("staff_id")
  code        String    @unique
  branchId    String    @map("branch_id")
  activeFrom  DateTime  @default(now()) @map("active_from")
  activeUntil DateTime? @map("active_until")
  reason      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  staff  Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch StaffLocation @relation(fields: [branchId], references: [id])

  @@index([staffId, activeFrom])
  @@map("staff_code_history")
}

model StaffEmploymentHistory {
  id              String              @id @default(uuid())
  staffId         String              @map("staff_id")
  roleTitle       String              @map("role_title")
  locationId      String              @map("location_id")
  employmentType  StaffEmploymentType @default(FULL_TIME) @map("employment_type")
  startDate       DateTime            @map("start_date")
  endDate         DateTime?           @map("end_date")
  reasonForChange String?             @map("reason_for_change")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  staff    Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location StaffLocation @relation(fields: [locationId], references: [id])

  @@index([staffId, startDate])
  @@index([locationId])
  @@map("staff_employment_history")
}

// ============================================================================
// PAYROLL & SALARY WALLET SYSTEM
// Deliberately its own ledger (StaffWallet/StaffWalletTransaction), separate
// from the customer/beautician Wallet — salary money and customer spending
// money should never share one balance, even for a staff member who also
// happens to hold a customer account. Withdrawal mirrors the proven
// Beautician payout pattern (Paystack transfer, bank-account-on-file,
// admin-approved) but is kept as its own parallel set of services rather
// than generalizing the beautician-specific one, to avoid destabilizing a
// working system handling real money.
// ============================================================================

enum PayrollPeriodStatus {
  DRAFT // being calculated, not yet visible to staff
  AWAITING_RELEASE // payslips generated, wallets credited, locked until the Payday switch is on
  RELEASED // Payday switched on for this period — staff can withdraw
}

/// Payroll Developer Implementation Guide, section 15: "Show clear states:
/// unavailable, pending, published, corrected, and superseded." DRAFT here
/// covers both "unavailable" and "pending" from the guide's wording (there
/// is genuinely nothing to distinguish between them before a period leaves
/// DRAFT -- see PayrollPeriodStatus above, which already gates staff
/// visibility at the period level).
enum PayslipStatus {
  DRAFT
  PUBLISHED
  CORRECTED
  SUPERSEDED
  CANCELLED
}

enum PayslipAdjustmentType {
  BONUS
  DEDUCTION
}

// Dev Feedback Round 5, item #3: same correction pattern as Payslip
// itself (status/supersedesId/correctionReference) -- a correction
// keeps the original row (SUPERSEDED) and creates a new one, rather
// than overwriting amount in place, so "original amount, revised
// amount, reason, user, timestamp" is never lost.
enum PayrollAdjustmentStatus {
  ACTIVE
  SUPERSEDED
}

enum StaffWalletTransactionType {
  PAYROLL_CREDIT
  WITHDRAWAL
  WITHDRAWAL_REVERSED // credited back if a transfer fails after debit
}

enum StaffPayoutRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

// a staff member can only submit a change *request* (the pending* fields);
// an admin must explicitly approve it before it takes effect. Verification
// is done via Paystack's own account resolution at submission time — the
// same gateway used for the actual withdrawal transfer, so there's never a
// mismatch between "who we verified" and "who we're paying". `verified`/
// `verifiedAt` get set the moment that resolution succeeds.
model StaffBankAccount {
  id            String @id @default(uuid())
  staffId       String @unique @map("staff_id")
  bankCode      String @map("bank_code")
  bankName      String @map("bank_name")
  accountNumber String @map("account_number")
  accountName   String @map("account_name")

  verified        Boolean   @default(false)
  verifiedAt      DateTime? @map("verified_at")
  verificationRef String?   @map("verification_ref") // reserved for a future, more formal (e.g. KYC-grade) verification source, unused for now

  pendingBankCode      String?   @map("pending_bank_code")
  pendingBankName      String?   @map("pending_bank_name")
  pendingAccountNumber String?   @map("pending_account_number")
  pendingAccountName   String?   @map("pending_account_name")
  pendingRequestedAt   DateTime? @map("pending_requested_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_bank_accounts")
}

// Ongoing, editable compensation — fixes the gap where Staff.baseSalary
// never existed anywhere except a one-time OfferLetter snapshot from before
// they were even hired. This table is the audit trail of every change
// (raises, role changes); Staff.currentBaseSalary/currentAllowances (added
// below) hold the current snapshot for fast reads.
model StaffCompensationHistory {
  id            String   @id @default(uuid())
  staffId       String   @map("staff_id")
  baseSalary    Decimal  @map("base_salary") @db.Decimal(10, 2)
  allowances    Decimal? @db.Decimal(10, 2)
  note          String?
  effectiveDate DateTime @map("effective_date")
  changedById   String?  @map("changed_by_id") // nullable — admin-elevated change with no linked staff record
  createdAt     DateTime @default(now()) @map("created_at")

  staff     Staff  @relation("StaffCompensationHistory", fields: [staffId], references: [id], onDelete: Cascade)
  changedBy Staff? @relation("CompensationChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@map("staff_compensation_history")
}

model PayrollPeriod {
  id          String              @id @default(uuid())
  label       String // e.g. "August 2026"
  periodStart DateTime            @map("period_start")
  periodEnd   DateTime            @map("period_end")
  status      PayrollPeriodStatus @default(DRAFT)

  generatedAt   DateTime? @map("generated_at")
  generatedById String?   @map("generated_by_id")
  approvedAt    DateTime? @map("approved_at")
  approvedById  String?   @map("approved_by_id")
  releasedAt    DateTime? @map("released_at")
  releasedById  String?   @map("released_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payslips    Payslip[]
  adjustments PayrollAdjustment[]

  generatedBy Staff? @relation("PayrollGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  approvedBy  Staff? @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  releasedBy  Staff? @relation("PayrollReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@unique([periodStart, periodEnd])
  @@map("payroll_periods")
}

model Payslip {
  id              String @id @default(uuid())
  payrollPeriodId String @map("payroll_period_id")
  staffId         String @map("staff_id")

  /// Human-readable, unique reference shown on the payslip itself --
  /// distinct from `id` (a UUID isn't the kind of reference an employee
  /// reads over the phone to their HR office). Assigned once, at creation.
  payslipReference String @unique @map("payslip_reference")

  baseSalary           Decimal @map("base_salary") @db.Decimal(10, 2)
  allowances           Decimal @default(0) @db.Decimal(10, 2)
  overtimeAmount       Decimal @default(0) @map("overtime_amount") @db.Decimal(10, 2)
  commissionEarned     Decimal @default(0) @map("commission_earned") @db.Decimal(10, 2)
  commissionPaid       Decimal @default(0) @map("commission_paid") @db.Decimal(10, 2) // 0 in the first month per policy — earned and recorded, not paid
  bonusTotal           Decimal @default(0) @map("bonus_total") @db.Decimal(10, 2)
  extraWorkDayEarnings Decimal @default(0) @map("extra_work_day_earnings") @db.Decimal(10, 2) // approved-only (HCS v1.0 Part B, Phase 3) — daily rate × count of approved Extra Work Days this period

  attendanceDeduction  Decimal @default(0) @map("attendance_deduction") @db.Decimal(10, 2)
  latePenaltyDeduction Decimal @default(0) @map("late_penalty_deduction") @db.Decimal(10, 2)
  fineTotal            Decimal @default(0) @map("fine_total") @db.Decimal(10, 2)
  loanRepayment        Decimal @default(0) @map("loan_repayment") @db.Decimal(10, 2)
  taxDeduction         Decimal @default(0) @map("tax_deduction") @db.Decimal(10, 2)
  pensionDeduction     Decimal @default(0) @map("pension_deduction") @db.Decimal(10, 2)
  otherDeductionTotal  Decimal @default(0) @map("other_deduction_total") @db.Decimal(10, 2)

  grossPay        Decimal @map("gross_pay") @db.Decimal(10, 2)
  totalDeductions Decimal @map("total_deductions") @db.Decimal(10, 2)
  netPay          Decimal @map("net_pay") @db.Decimal(10, 2)

  isFirstMonth Boolean @default(false) @map("is_first_month")

  // ── Payroll Developer Implementation Guide, section 15 "Salary fields" ──
  // Show only when salary applies (compensationType is not COMMISSION).
  // salaryEffectiveDate/scheduledWorkdays/etc. are all frozen here at
  // calculation time rather than derived live from Staff/StaffCompensationHistory
  // at display time, matching the guide's "generate payslips from immutable
  // finalized payroll data" and "finalized payroll must retain the rate used"
  // requirements -- a later change to the staff record must never alter an
  // already-finalized payslip's numbers.
  salaryEffectiveDate        DateTime? @map("salary_effective_date") @db.Date
  fullMonthScheduledWorkdays Int?      @map("full_month_scheduled_workdays")
  applicableScheduledWorkdays Int?     @map("applicable_scheduled_workdays")
  missedWorkdays              Int?     @map("missed_workdays")
  approvedExtraWorkdaysCount  Int?     @map("approved_extra_workdays_count")
  payableWorkdays             Decimal? @map("payable_workdays") @db.Decimal(5, 2)
  dailyRate                   Decimal? @map("daily_rate") @db.Decimal(10, 2)
  salaryEarned                Decimal? @map("salary_earned") @db.Decimal(10, 2)
  /// "Confirmed Work Days" -- the actual worked/payable days for this
  /// period (same figure as payableWorkdays, but also populated for
  /// COMMISSION-only staff, who previously got no workday breakdown at
  /// all). Denominator for effectiveDailyPay below.
  confirmedWorkdays              Int?     @map("confirmed_workdays")
  /// SALARY_TO_COMMISSION only -- confirmedWorkdays for the commission
  /// sub-range specifically, kept separate from confirmedWorkdays (the
  /// salary sub-range's count) so the two can be summed without
  /// double-counting.
  commissionPeriodConfirmedWorkdays Int? @map("commission_period_confirmed_workdays")
  /// Informational per-day rate, computed AFTER salaryEarned/
  /// commissionEarned are already determined -- never drives actual pay.
  /// See PayrollSalaryCalculatorService.SalaryCalculationResult for the
  /// per-compensation-type formula.
  effectiveDailyPay              Decimal? @map("effective_daily_pay") @db.Decimal(10, 2)

  // ── "First applicable payroll month" fields — show only when relevant ──
  staffHireDateSnapshot DateTime? @map("staff_hire_date_snapshot") @db.Date

  // ── "Salary-to-commission fields" — show only for SALARY_TO_COMMISSION ──
  cutoffDayUsed          Int?      @map("cutoff_day_used")
  cutoffClassification   String?   @map("cutoff_classification") // "BEFORE_CUTOFF" | "ON_OR_AFTER_CUTOFF"
  salaryPeriodStart      DateTime? @map("salary_period_start") @db.Date
  salaryPeriodEnd        DateTime? @map("salary_period_end") @db.Date
  commissionPeriodStart  DateTime? @map("commission_period_start") @db.Date
  commissionPeriodEnd    DateTime? @map("commission_period_end") @db.Date
  transitionDate         DateTime? @map("transition_date") @db.Date
  /// "Any cutoff override requires authorized admin permission, a reason,
  /// and an audit record." The audit record itself lives in SystemAuditLog;
  /// these two fields let the payslip display the override inline without
  /// needing a join back to that log.
  cutoffOverrideReason   String?   @map("cutoff_override_reason")
  cutoffOverrideById     String?   @map("cutoff_override_by_id")

  // ── "Commission fields" — show only when commission applies ──
  commissionPlanIdUsed       String?   @map("commission_plan_id_used")
  commissionRateUsed         Decimal?  @map("commission_rate_used") @db.Decimal(5, 4)
  commissionRateEffectiveDate DateTime? @map("commission_rate_effective_date") @db.Date

  // ── Status / correction model (section 15, "Staff portal and download requirements") ──
  status              PayslipStatus @default(DRAFT)
  publishedAt         DateTime?     @map("published_at")
  supersedesId        String?       @unique @map("supersedes_id") // the older payslip this one replaces, if this IS a correction
  correctionReference String?       @map("correction_reference") // human-readable note on why this correction was issued

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payrollPeriod PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staff         Staff               @relation("StaffPayslips", fields: [staffId], references: [id])
  adjustments   PayrollAdjustment[]
  cutoffOverrideBy Staff?           @relation("PayslipCutoffOverrideBy", fields: [cutoffOverrideById], references: [id], onDelete: SetNull)
  commissionPlanUsed CommissionPlan? @relation(fields: [commissionPlanIdUsed], references: [id], onDelete: SetNull)
  supersedes    Payslip?            @relation("PayslipCorrection", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  Payslip?            @relation("PayslipCorrection")

  // Dev note: NOT @@unique([payrollPeriodId, staffId]) any more -- a
  // correction (Phase 3) needs a second row to coexist with the original
  // for the same period+staff pair (the original stays, marked SUPERSEDED,
  // per the guide's "retain the original" requirement). Real uniqueness
  // among ACTIVE payslips is enforced by a partial unique index at the DB
  // level instead (see migration 20260827160000), which Prisma's schema
  // DSL can't express natively -- generatePayroll()'s upsert was rewritten
  // as an explicit find-then-create/update for the same reason (it can no
  // longer target a compound-unique Prisma doesn't know about).
  @@index([payrollPeriodId, staffId])
  @@index([staffId])
  @@index([status])
  @@map("payslips")
}

// Manual bonus/deduction line items. `category` holds the specific named
// type from the spec (e.g. "Performance Bonus", "Loan Repayment", "Damage
// Charges") as free text — kept flexible rather than a rigid enum, since new
// categories will likely come up in practice.
model PayrollAdjustment {
  id              String                @id @default(uuid())
  payrollPeriodId String                @map("payroll_period_id")
  payslipId       String?               @map("payslip_id") // set once the period is processed and a payslip exists
  staffId         String                @map("staff_id")
  type            PayslipAdjustmentType
  category        String
  amount          Decimal               @db.Decimal(10, 2)
  reason          String
  // Dev Feedback Round 5, item #3 additions below. effectiveDate is the
  // date the deduction/bonus actually pertains to (e.g. the date of the
  // incident it charges for) -- distinct from createdAt, which is just
  // when the record was entered. notes is a longer free-text field
  // alongside reason's shorter categorical label, same split already
  // used for StockAdjustment's reasonCategory + reason.
  effectiveDate   DateTime?             @map("effective_date") @db.Date
  notes           String?
  status              PayrollAdjustmentStatus @default(ACTIVE)
  supersedesId        String?                 @unique @map("supersedes_id")
  correctionReason    String?                 @map("correction_reason")
  createdById     String?               @map("created_by_id") // nullable — admin-elevated action with no linked staff record
  createdAt       DateTime              @default(now()) @map("created_at")

  payrollPeriod PayrollPeriod            @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  payslip       Payslip?                 @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  staff         Staff                    @relation("StaffAdjustments", fields: [staffId], references: [id])
  createdBy     Staff?                   @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supersedes    PayrollAdjustment?       @relation("AdjustmentCorrection", fields: [supersedesId], references: [id], onDelete: SetNull)
  correctedBy   PayrollAdjustment?       @relation("AdjustmentCorrection")

  @@index([staffId])
  @@index([payrollPeriodId])
  @@map("payroll_adjustments")
}

// Dev Feedback Round 4, items #22-24: dedicated audit trail for every
// sensitive payroll action -- deliberately a NEW model, not shoehorned
// into RoleAuditLog (which is specifically scoped to role/permission
// changes, by its own action enum) or any other existing log. Free-text
// action/entityType rather than enums, matching PayrollAdjustment's own
// "category" field reasoning -- the set of loggable payroll actions is
// likely to grow, and a rigid enum would need a migration every time.
model PayrollAuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "PERIOD_CREATED", "PAYROLL_GENERATED", "SENT_FOR_CORRECTION", "PERIOD_APPROVED", "ADJUSTMENT_CREATED", "WITHDRAWAL_APPROVED", "WITHDRAWAL_REJECTED"
  entityType String   @map("entity_type") // e.g. "PayrollPeriod", "PayrollAdjustment", "StaffPayoutRequest"
  entityId   String   @map("entity_id")
  staffId    String?  @map("staff_id") // the staff member this action concerns, when applicable (e.g. whose withdrawal, whose adjustment) -- null for period-level actions
  actorId    String?  @map("actor_id") // nullable -- a system-initiated action (e.g. auto-generated) has no human actor
  note       String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor Staff? @relation("PayrollAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  staff Staff? @relation("PayrollAuditSubject", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([staffId])
  @@index([createdAt])
  @@map("payroll_audit_logs")
}

// Dev Feedback Round 4, item #47: generic, system-wide audit trail for
// sensitive actions OUTSIDE payroll (which has its own PayrollAuditLog
// above) and roles/permissions (which already has RoleAuditLog) --
// fines, campaign create/edit/delete, discount/coupon changes,
// deletions across other modules, and any other sensitive action that
// doesn't already have a dedicated log. Same shape as PayrollAuditLog,
// deliberately kept separate from it rather than merged: payroll's
// volume and query patterns (filtering by period, by staff) are
// different enough from this catch-all's that a shared table would
// need extra columns just to distinguish them.
model SystemAuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "LATE_PENALTY_APPLIED", "DISCOUNT_DELETED", "CAMPAIGN_TEMPLATE_CREATED"
  entityType String   @map("entity_type") // e.g. "AttendanceRecord", "DiscountCode", "LifecycleCampaignTemplate"
  entityId   String   @map("entity_id")
  staffId    String?  @map("staff_id") // the staff member this action concerns, when applicable -- null for actions with no specific subject
  actorId    String?  @map("actor_id") // nullable -- a system-initiated action (e.g. auto-applied late penalty) has no human actor
  note       String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor Staff? @relation("SystemAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  staff Staff? @relation("SystemAuditSubject", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([staffId])
  @@index([createdAt])
  @@map("system_audit_logs")
}

model StaffWallet {
  id        String   @id @default(uuid())
  staffId   String   @unique @map("staff_id")
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff        Staff                    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  transactions StaffWalletTransaction[]

  @@map("staff_wallets")
}

model StaffWalletTransaction {
  id          String                     @id @default(uuid())
  walletId    String                     @map("wallet_id")
  type        StaffWalletTransactionType
  amount      Decimal                    @db.Decimal(10, 2)
  status      TransactionStatus          @default(PENDING)
  reference   String                     @unique
  description String?
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  wallet             StaffWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  staffPayoutRequest StaffPayoutRequest?

  @@index([walletId])
  @@map("staff_wallet_transactions")
}

model StaffPayoutRequest {
  id                        String                   @id @default(uuid())
  staffId                   String                   @map("staff_id")
  amount                    Decimal                  @db.Decimal(10, 2)
  status                    StaffPayoutRequestStatus @default(PENDING)
  bankCode                  String                   @map("bank_code")
  accountNumber             String                   @map("account_number")
  accountName               String?                  @map("account_name")
  processedById             String?                  @map("processed_by_id")
  processedAt               DateTime?                @map("processed_at")
  rejectionReason           String?                  @map("rejection_reason")
  transactionId             String?                  @unique @map("transaction_id")
  paystackTransferReference String?                  @unique @map("paystack_transfer_reference")
  paystackTransferCode      String?                  @map("paystack_transfer_code")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")

  staff       Staff                   @relation("StaffPayoutRequests", fields: [staffId], references: [id], onDelete: Cascade)
  processedBy Staff?                  @relation("StaffPayoutProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  transaction StaffWalletTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([status])
  @@map("staff_payout_requests")
}

// Singleton — the "Payday" switch. OFF: salaries stay locked in the wallet
// even though they've been credited. ON: staff can withdraw immediately.
// Manually toggled by an admin — no automatic schedule.
model PayrollSettings {
  id            String   @id @default(uuid())
  releaseActive Boolean  @default(false) @map("release_active")
  // 8% is the standard Nigerian employee pension contribution rate as of
  // the Nigeria Tax Act 2025 (effective Jan 2026) — configurable here in
  // case Hairlux's accountant determines a different treatment applies.
  pensionRate   Decimal  @default(0.08) @map("pension_rate") @db.Decimal(5, 4)
  // Dev Feedback Round 8: replaces the progressive Nigeria PAYE band
  // calculation (src/payroll/utils/paye-calculator.ts) with a single,
  // admin-configurable flat rate -- percentage as decimal, e.g. 0.075 =
  // 7.5%. Defaults to 0 (no tax deducted) rather than a guessed
  // percentage, since this is a real financial calculation and Hairlux's
  // accountant should be the one setting it deliberately.
  taxRate       Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 4)
  // Payroll Developer Implementation Guide, section 9: "Apply the
  // configured 15th cutoff rule" -- the guide's own wording implies this
  // is a setting, not a hardcoded constant, even though every example in
  // the document uses 15.
  salaryToCommissionCutoffDay Int @default(15) @map("salary_to_commission_cutoff_day")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("payroll_settings")
}

/**
 * Dev Feedback Round 6, item #17: the daily revenue-submission deadline
 * (Dev Feedback Round 4, items #25-29 -- "yesterday's window closes at
 * noon today") was hardcoded as '12:00'. Admin-configurable, singleton
 * settings row, matching PayrollSettings' own pattern above. Plain
 * "HH:mm" string, matching watDateAtTime's own expected format.
 */
model BranchFinanceSettings {
  id                     String   @id @default(uuid())
  submissionDeadlineTime String   @default("12:00") @map("submission_deadline_time")
  updatedById            String?  @map("updated_by_id")
  updatedAt              DateTime @updatedAt @map("updated_at")

  updatedBy Staff? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("branch_finance_settings")
}

/**
 * The homepage "Trusted by Thousands" stats strip -- each field is an
 * admin-set override for the number actually displayed. All nullable:
 * when null, the live-computed count is used instead (completed
 * bookings, registered customers, average rating, active branches,
 * active staff). Real "trust" numbers on a marketing page are commonly
 * curated/rounded rather than the literal live DB count, so this is
 * deliberately override-based rather than purely computed -- an admin
 * sees the live figure and can choose to display it as-is or adjust it.
 */
model SiteStats {
  id                        String   @id @default(uuid())
  completedBookingsOverride Int?     @map("completed_bookings_override")
  registeredCustomersOverride Int?   @map("registered_customers_override")
  averageRatingOverride     Decimal? @map("average_rating_override") @db.Decimal(2, 1)
  branchesOverride          Int?     @map("branches_override")
  professionalsOverride     Int?     @map("professionals_override")
  updatedById               String?  @map("updated_by_id")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  updatedBy Staff? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_stats")
}

model BranchService {
  id          String   @id @default(uuid())
  branchId    String   @map("branch_id")
  serviceId   String   @map("service_id")
  isAvailable Boolean  @default(true) @map("is_available")
  walkInPrice Decimal? @map("walk_in_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch  StaffLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceId])
  @@index([branchId])
  @@index([serviceId])
  @@map("branch_services")
}

model StaffLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  address   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // GPS fields for Attendance clock-in/out validation (bundled in ahead of the Attendance build)
  gpsLat               Decimal? @map("gps_lat") @db.Decimal(10, 7)
  gpsLng               Decimal? @map("gps_lng") @db.Decimal(10, 7)
  approvedRadiusMeters Int?     @map("approved_radius_meters")

  lateGracePeriodMinutes Int @default(10) @map("late_grace_period_minutes")

  // Branch Manager — max one active manager per branch, enforced by the unique
  // constraint below (a staff member can only be the designated manager of one
  // branch at a time; unset before reassigning them elsewhere).
  managerId String? @unique @map("manager_id")
  manager   Staff?  @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)

  staff                    Staff[]
  histories                StaffEmploymentHistory[]
  codeHistory              StaffCodeHistory[]
  branchServices           BranchService[]
  interviewApplications    Application[]             @relation("ApplicationInterviewLocation")
  jobPostings              JobPosting[]              @relation("JobPostingPrimaryBranch")
  jobPostingBranches       JobPostingBranch[]
  dailyCashReconciliations DailyCashReconciliation[]
  businessExceptions       BusinessException[]
  offerLetters             OfferLetter[]             @relation("OfferLetterBranch")

  bookings              Booking[]
  targetedAnnouncements Announcement[]
  attendanceRecords     AttendanceRecord[]
  inventoryLogEntries   InventoryLogEntry[]
  approvalRequests      ApprovalRequest[]
  salonBookings         SalonBooking[]

  staffSequence  Int             @default(0) @map("staff_sequence")
  inventoryItems InventoryItem[]
  // stockTransfers StockTransfer[]

  incomingTransfers StockTransfer[]
  productSales      ProductSale[]
  financialTransactions FinancialTransaction[]
  purchaseRequests  PurchaseRequest[]
  purchases         Purchase[]
  managedByAdditionalStaff StaffManagedFinanceBranch[]
  commissionPlans   CommissionPlan[]

  @@map("staff_locations")
}

/**
 * Dev Feedback Round 4, item #25: grants a staff member finance-view
 * access to a branch beyond their own primary one -- a real many-to-many,
 * unlike StaffLocation.managerId (one designated manager per branch,
 * kept unchanged for its own existing purpose). A staff member's own
 * Staff.locationId is always implicitly accessible without needing a row
 * here.
 */
model StaffManagedFinanceBranch {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  branchId  String   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  staff  Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch StaffLocation @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffId, branchId])
  @@index([staffId])
  @@index([branchId])
  @@map("staff_managed_finance_branches")
}

// One row per thing awaiting approval, regardless of what kind of thing it is —
// requestType tells you which domain table (LeaveRequest, future
// InventoryAdjustment, etc.) owns the business data; this table owns the
// approval workflow itself: who it's currently sitting with, and its status.
model ApprovalRequest {
  id                String              @id @default(uuid())
  requestType       ApprovalRequestType @map("request_type")
  branchId          String?             @map("branch_id")
  submittedById     String?             @map("submitted_by_id") // null = admin-initiated with no linked staff record
  currentApproverId String?             @map("current_approver_id")
  // Phase 4: both nullable, both unused by every existing request type
  // (Leave, Inventory Adjustment, Stock Transfer) -- those keep the
  // existing single-approver behavior byte-for-byte unchanged, since
  // they will never have an ApprovalChainStage configured. Only a
  // request type an admin has actually configured a chain for (e.g.
  // PURCHASE_REQUEST) gets routed by role instead of by person: when
  // chain-based, currentApproverId stays null (no one specific person is
  // assigned) and currentStageRoleId names which AdminRole can act right
  // now -- anyone holding that role can approve/reject.
  currentStageOrder  Int?    @map("current_stage_order")
  currentStageRoleId String? @map("current_stage_role_id")
  status             ApprovalStatus @default(PENDING)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  branch          StaffLocation? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  submittedBy     Staff?         @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id])
  currentApprover Staff?         @relation("ApprovalCurrentApprover", fields: [currentApproverId], references: [id], onDelete: SetNull)
  currentStageRole AdminRole?    @relation(fields: [currentStageRoleId], references: [id], onDelete: SetNull)

  actions                ApprovalAction[]
  leaveRequest           LeaveRequest?
  stockAdjustmentRequest StockAdjustmentRequest?
  stockTransfer          StockTransfer?
  purchaseRequest        PurchaseRequest?

  @@index([currentApproverId, status])
  @@index([requestType, status])
  @@index([currentStageRoleId, status])
  @@map("approval_requests")
}

/**
 * Admin-configurable approval chain per request type -- e.g. Purchase
 * Request: stage 1 = "Branch Manager" role, stage 2 = "EA/Admin" role,
 * stage 3 = "Managing Director" role. A request type with zero rows here
 * gets the original, unmodified single-approver behavior; only once an
 * admin actually configures stages does that request type route through
 * them instead. No fixed hierarchy is hardcoded anywhere in code -- this
 * table IS the hierarchy, editable without a deploy.
 */
model ApprovalChainStage {
  id             String              @id @default(uuid())
  requestType    ApprovalRequestType @map("request_type")
  stageOrder     Int                 @map("stage_order")
  approverRoleId String              @map("approver_role_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  approverRole AdminRole @relation(fields: [approverRoleId], references: [id], onDelete: Cascade)

  @@unique([requestType, stageOrder])
  @@index([requestType])
  @@map("approval_chain_stages")
}

// Full stage-by-stage history for an ApprovalRequest — every submit, approve,
// reject, reassignment, and info-request is a row here, so "who saw this and
// when" is always answerable, never just the current state.
model ApprovalAction {
  id                String             @id @default(uuid())
  approvalRequestId String             @map("approval_request_id")
  actorId           String?            @map("actor_id") // null = system-initiated
  action            ApprovalActionType
  fromApproverId    String?            @map("from_approver_id")
  toApproverId      String?            @map("to_approver_id")
  comment           String?
  actedAt           DateTime           @default(now()) @map("acted_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  actor           Staff?          @relation("ApprovalActionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([approvalRequestId])
  @@map("approval_actions")
}

model LeaveRequest {
  id                String             @id @default(uuid())
  staffId           String             @map("staff_id")
  type              LeaveRequestType
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  startTime         String?            @map("start_time")
  endTime           String?            @map("end_time")
  reason            String
  status            LeaveRequestStatus @default(PENDING)
  approverId        String?            @map("approver_id")
  approvedAt        DateTime?          @map("approved_at")
  rejectionReason   String?            @map("rejection_reason")
  approvalRequestId String?            @unique @map("approval_request_id")
  // Dev Feedback Round 6, item #22: the frontend already collected a
  // required reassignment reason and called a PATCH .../reassign
  // endpoint that never existed on the backend at all. approverId is
  // overwritten on reassign (matches its own existing "current
  // approver" semantics) -- these three track the fact and reason of
  // the most recent reassignment, not a full history log.
  reassignmentReason String?           @map("reassignment_reason")
  reassignedAt       DateTime?         @map("reassigned_at")
  reassignedById     String?           @map("reassigned_by_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  approver        Staff?           @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  reassignedBy    Staff?           @relation("LeaveRequestReassignedBy", fields: [reassignedById], references: [id], onDelete: SetNull)
