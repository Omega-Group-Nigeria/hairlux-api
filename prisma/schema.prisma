  CASUAL_LEAVE
  DAY_OFF
  PERMISSION_LATE_ARRIVAL
  PERMISSION_EARLY_DEPARTURE
  OVERTIME_REQUEST
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffOnboardingItem {
  id           String                     @id @default(uuid())
  staffId      String                     @map("staff_id")
  type         OnboardingItemType
  isComplete   Boolean                    @default(false) @map("is_complete")
  reviewStatus OnboardingItemReviewStatus @default(NOT_STARTED) @map("review_status")
  submittedAt  DateTime?                  @map("submitted_at")
  completedAt  DateTime?                  @map("completed_at")
  completedBy  String?                    @map("completed_by") // admin userId
  notes        String?
  createdAt    DateTime                   @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, type])
  @@map("staff_onboarding_items")
}

model CompanyDocument {
  id         String              @id @default(uuid())
  type       CompanyDocumentType
  version    Int                 @default(1)
  title      String
  contentUrl String              @map("content_url")
  isActive   Boolean             @default(true) @map("is_active")
  createdAt  DateTime            @default(now()) @map("created_at")

  acknowledgments StaffDocumentAcknowledgment[]

  @@map("company_documents")
}

enum InterviewOutcome {
  PASS
  FAIL
  HOLD
}

enum OfferLetterStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER_EXTENDED
  EMPLOYED
  NOT_SELECTED
}

enum SupplierType {
  SUPPLIER
  VENDOR
}

enum InventoryCategory {
  FOR_SALE
  INTERNAL_USE
  STORAGE
}

enum StockMovementType {
  RECEIVED // goods received into stock
  SOLD // deducted via a sale
  CONSUMED // reserved for Service Material Consumption, once that module exists
  ADJUSTMENT // manual correction — requires a reason
  TRANSFER_OUT // moved to another branch
