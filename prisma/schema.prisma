enum PurchaseRequestStatus {
  DRAFT
  PENDING       // submitted, awaiting the first (or only) approval stage
  UNDER_REVIEW  // at least one stage has approved, chain not yet finished
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * The starting point of the procurement chain (spec §4-5). A Draft has
 * no ApprovalRequest yet; submitting creates one via the shared
 * ApprovalService (reusing the Phase 4a configurable chain -- if an
 * admin has configured stages for PURCHASE_REQUEST, this routes through
 * them; otherwise it falls back to the original single-approver
 * behavior). status is kept in sync with the underlying ApprovalRequest
 * by the service layer, not derived live on every read, since a Purchase
 * Request's own status needs to be filterable/sortable directly.
 */
model PurchaseRequest {
  id             String                @id @default(uuid())
  requestNumber  Int                   @default(autoincrement()) @map("request_number") // display-formatted as "PR-2026-000123", same convention as SalonBooking.bookingNumber
  branchId       String                @map("branch_id")
  vendorId       String                @map("vendor_id")
  requestedById  String?               @map("requested_by_id") // null = admin-initiated with no linked staff record
  reason         String
  attachmentUrl  String?               @map("attachment_url")
  status         PurchaseRequestStatus @default(DRAFT)
  approvalRequestId String?            @unique @map("approval_request_id")
  grandTotal     Decimal               @default(0) @map("grand_total") @db.Decimal(12, 2)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  branch          StaffLocation    @relation(fields: [branchId], references: [id])
  vendor          Supplier         @relation(fields: [vendorId], references: [id])
  requestedBy     Staff?           @relation(fields: [requestedById], references: [id])
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  lines           PurchaseRequestLine[]
  purchase        Purchase?

  @@index([branchId, status])
  @@index([vendorId])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String  @id @default(uuid())
  purchaseRequestId String  @map("purchase_request_id")
  productId         String  @map("product_id")
  quantity          Int
  // Auto-filled from the product's last approved purchase price when the
  // line is added, but always overridable by an authorized user -- per
  // spec §4.1. Approval of the request is what sets this as the new
  // reference price for next time (handled in the service, not here).
  estimatedPrice    Decimal @map("estimated_price") @db.Decimal(10, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  purchaseRequest PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  product         InventoryProduct @relation(fields: [productId], references: [id])

  @@index([purchaseRequestId])
  @@index([productId])
  @@map("purchase_request_lines")
}

enum PurchaseStatus {
  PENDING
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  COMPLETED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  FULLY_PAID
  OVERPAID
}

/**
 * Created automatically the moment its source PurchaseRequest is
 * approved -- never created directly, never re-enters product data (spec
 * §6: "Do not require the user to recreate the products"). Lines are
 * copied from the approved PurchaseRequestLines at conversion time, since
 * approval is what locks in the reference price (spec §4.1) -- a later
 * edit to the product's price must never retroactively change an
 * already-approved purchase.
 *
 * amountPaid is a denormalized running total the service keeps in sync
 * on every PurchasePayment, not computed live on every read -- same
 * "service-maintained snapshot, not recomputed" convention as
 * Staff.currentBaseSalary elsewhere in this codebase, since this field
 * is read constantly (purchase list, Vendor Ledger) and rarely written.
 */
model Purchase {
  id                String                 @id @default(uuid())
  purchaseNumber    Int                    @default(autoincrement()) @map("purchase_number") // display-formatted as "PO-2026-000123"
  purchaseRequestId String                 @unique @map("purchase_request_id")
  branchId          String                 @map("branch_id")
  vendorId          String                 @map("vendor_id")
  purchaseDate      DateTime               @default(now()) @map("purchase_date")
  status            PurchaseStatus         @default(PENDING)
  paymentStatus     PurchasePaymentStatus  @default(UNPAID) @map("payment_status")
  grandTotal        Decimal                @map("grand_total") @db.Decimal(12, 2)
  amountPaid        Decimal                @default(0) @map("amount_paid") @db.Decimal(12, 2)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  branch          StaffLocation   @relation(fields: [branchId], references: [id])
  vendor          Supplier        @relation(fields: [vendorId], references: [id])
  lines           PurchaseLine[]
  payments        PurchasePayment[]
  goodsReceipts   GoodsReceipt[]
  ledgerAdjustments VendorLedgerAdjustment[]

  @@index([branchId, status])
  @@index([vendorId])
  @@index([paymentStatus])
  @@map("purchases")
}

model PurchaseLine {
  id         String  @id @default(uuid())
  purchaseId String  @map("purchase_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2) // locked in at conversion from the approved request line -- never changes afterward
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  purchase           Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product            InventoryProduct     @relation(fields: [productId], references: [id])
  goodsReceiptLines  GoodsReceiptLine[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_lines")
}

/**
 * One row per actual payment made toward a Purchase -- a partial payment
 * is a normal, expected case (spec §7, §23), not an edge case. Each row
 * also produces a FinancialTransaction OUTFLOW (handled in the service,
 * not here) -- source of truth for "how much has actually been paid" is
 * this table; Purchase.amountPaid is a maintained cache of its sum.
 */
model PurchasePayment {
  id                String   @id @default(uuid())
  purchaseId        String   @map("purchase_id")
  amount            Decimal  @db.Decimal(12, 2)
  paymentMethod     String   @map("payment_method") // free text -- same reasoning as FinancialTransaction.paymentMethod
  paymentDate       DateTime @map("payment_date")
  paymentReference  String?  @map("payment_reference")
  recordedById      String?  @map("recorded_by_id")
  financialTransactionId String? @unique @map("financial_transaction_id")
  createdAt         DateTime @default(now()) @map("created_at")

  purchase              Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  recordedBy            Staff?                @relation(fields: [recordedById], references: [id])
  financialTransaction  FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@map("purchase_payments")
}

/**
 * One row per physical delivery event against a Purchase -- the spec's
 * "Goods Receiving" screen. Multiple partial deliveries against one
 * Purchase are normal (spec §8's worked example: 70 then 30 against an
 * order of 100), each producing its own GoodsReceipt. Inventory only
 * ever increases here, never at Purchase creation (spec §8's stated
 * critical business rule) -- enforced in the service, not the schema.
 */
model GoodsReceipt {
  id             String   @id @default(uuid())
  receiptNumber  Int      @default(autoincrement()) @map("receipt_number") // display-formatted as "GRN-2026-000123"
  purchaseId     String   @map("purchase_id")
  receivedDate   DateTime @default(now()) @map("received_date")
  receivedById   String?  @map("received_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  purchase   Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  receivedBy Staff?             @relation(fields: [receivedById], references: [id])
  lines      GoodsReceiptLine[]

  @@index([purchaseId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String    @id @default(uuid())
  goodsReceiptId String    @map("goods_receipt_id")
  purchaseLineId String    @map("purchase_line_id")
  deliveredQty   Int       @map("delivered_qty")
  damagedQty     Int       @default(0) @map("damaged_qty")
  // Stored explicitly rather than always computed as delivered-damaged --
  // spec §8 lists Accepted Quantity as its own field, and a stored value
  // survives correctly even if delivered/damaged figures are later
  // corrected for record-keeping, without silently changing what actually
  // already entered inventory.
  acceptedQty    Int       @map("accepted_qty")
  batchLotNumber String?   @map("batch_lot_number")
  expiryDate     DateTime? @map("expiry_date") @db.Date

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseLine PurchaseLine @relation(fields: [purchaseLineId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseLineId])
  @@map("goods_receipt_lines")
}

enum VendorLedgerAdjustmentType {
  CREDIT // reduces what Hairlux owes the vendor (e.g. a credit note for damaged/returned goods)
  DEBIT  // increases what Hairlux owes the vendor (e.g. a pricing correction found after the fact)
}

/**
 * Procurement/Inventory/Finance Integration, Phase 5 (Vendor Ledger).
 * The spec's own words: the ledger is "fully derived/calculated from
 * Procurement + Payment + Receiving + Adjustments... never manually
 * maintained as a separate balance." Purchases, payments, and receiving
 * are already fully modeled (Purchase.grandTotal/amountPaid,
 * PurchasePayment, GoodsReceipt/GoodsReceiptLine) -- this is the one
 * missing input: a standalone credit/debit entry against a vendor that
 * isn't itself a purchase or a payment. The ledger balance itself is
 * computed on read (VendorLedgerService), never stored here or anywhere
 * else -- this table holds only the adjustment inputs to that
 * computation, immutable and append-only once created (spec: "completed
 * financial/stock transactions should use archive/soft-delete... rather
 * than permanent deletion").
 */
model VendorLedgerAdjustment {
  id                 String                     @id @default(uuid())
  vendorId           String                     @map("vendor_id")
  type               VendorLedgerAdjustmentType
  amount             Decimal                    @db.Decimal(12, 2)
  reason             String
  referencePurchaseId String?                   @map("reference_purchase_id")
  createdById        String?                    @map("created_by_id")
  createdAt          DateTime                   @default(now()) @map("created_at")

  vendor            Supplier  @relation(fields: [vendorId], references: [id])
  referencePurchase Purchase? @relation(fields: [referencePurchaseId], references: [id], onDelete: SetNull)
  createdBy         Staff?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([referencePurchaseId])
  @@map("vendor_ledger_adjustments")
}

